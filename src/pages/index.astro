---
// DD_v2.1.md §4 — hero + sparse project list. No filter bar anymore (v1 had one) — the
// hero transitions straight into the projects. §4.4 REVISED: 2-column grid at desktop
// (was a single stacked column in v2), 1 column at mobile — see .project-list below.
//
// OPEN-ITEM DECISION (§2.1/§9, "not decided yet"): the Other section is built here as
// a section at the bottom of the index page, not a dedicated `/other` page. Reasoning:
// it currently holds only an optional QA-filler entry (no real taekwondo/tutoring
// content this pass, per §7/§10), so a whole separate route would just be a mostly
// empty page — a bottom-of-index section is the lighter-weight choice and mirrors how
// v1 handled it. Flagging this since the doc left it open; easy to split into its own
// page later if the Other section grows real content.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PlaneField from '../components/PlaneField.astro';

const allBlocks = await getCollection('blocks');

const mainBlocks = allBlocks
  .filter((b) => !b.data.isOther)
  .sort((a, b) => a.data.priority - b.data.priority)
  .map((b) => b.data);

const otherBlocks = allBlocks
  .filter((b) => b.data.isOther)
  .sort((a, b) => a.data.priority - b.data.priority)
  .map((b) => b.data);
---

<Layout title="PWeb — Layout Pilot">
  <div class="page-body">
    <PlaneField />

    <Hero />

    <section id="projects" class="project-list">
      {mainBlocks.map((block) => <ProjectCard block={block} />)}
    </section>

    {
      otherBlocks.length > 0 && (
        <>
          <div class="other-divider" role="separator">
            <span class="line" />
            <span class="label">Other</span>
            <span class="line" />
          </div>
          <section class="project-list other-list">
            {otherBlocks.map((block) => (
              <ProjectCard block={block} />
            ))}
          </section>
        </>
      )
    }
  </div>
</Layout>

<style>
  .page-body {
    /* Positioning context + width constraint for PlaneField's page-length overlay —
       see PlaneField.astro's own comment for why this needs a max-width rather than
       spanning the true viewport edge-to-edge. */
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 1rem;
  }

  @media (max-width: 720px) {
    .project-list {
      grid-template-columns: 1fr;
    }
  }

  .other-divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: 900px;
    margin: 1rem auto 0;
    padding: 0 1.5rem;
  }

  .other-divider .line {
    flex: 1;
    height: 1px;
    background: rgba(255, 255, 255, 0.15);
  }

  .other-divider .label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--page-text-dim);
  }
</style>

<script>
  // DD_v2.md §4.4 — scroll-triggered fade/slide-in as cards enter viewport, standard
  // IntersectionObserver pattern, no Svelte state needed (§1.1: prefer plain JS/Astro
  // now that no large stateful island is required).
  //
  // Replayable: toggles .is-visible on a 50% visibility threshold rather than
  // one-shot-then-unobserve, so a card slides back out once more than half of it has
  // scrolled off (either edge) and slides back in when it crosses back past 50% —
  // works the same scrolling down or back up since it's just tracking the ratio, not a
  // direction.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cards = document.querySelectorAll('[data-reveal]');

  if (reduced) {
    cards.forEach((c) => c.classList.add('is-visible'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.classList.toggle('is-visible', entry.intersectionRatio >= 0.5);
        }
      },
      { threshold: 0.5 }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>
