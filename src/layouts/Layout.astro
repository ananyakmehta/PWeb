---
// DD_v2.md §2.2 — single shared layout wrapping every page (index + all detail pages),
// so the constellation background, nav, and cursor persist across navigation instead
// of being rebuilt per page.
import '../styles/global.css';
import ConstellationBackground from '../components/ConstellationBackground.astro';
import CursorSystem from '../components/CursorSystem.svelte';
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <ConstellationBackground />
    <CursorSystem client:load />
    <div class="page-content">
      <Nav />
      <slot />
    </div>
  </body>
</html>

<style>
  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
