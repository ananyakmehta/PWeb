---
// DD_v2.1.md §2.2 (carried from v2, unchanged): single shared layout wrapping every
// page, so background and nav persist across navigation. §5.1: the constellation
// starfield is fully replaced by the reactive halftone background. The custom "ship
// of the imagination" cursor (previously CursorSystem.svelte here) was removed per
// direct instruction — plain native cursor sitewide now.
// Display font (Raleway, swapped from Arvo per direct instruction) loaded here for the
// whole site's headings/nav.
import '../styles/global.css';
import ReactiveHalftoneBackground from '../components/ReactiveHalftoneBackground.svelte';
import KonamiEasterEgg from '../components/KonamiEasterEgg.svelte';
import StaticModeToggle from '../components/StaticModeToggle.svelte';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <ReactiveHalftoneBackground client:load />
    <KonamiEasterEgg client:load />
    <StaticModeToggle client:load />
    <div class="page-content">
      <Nav />
      <slot />
      <Footer />
    </div>
  </body>
</html>

<style>
  .page-content {
    position: relative;
    z-index: 1;
  }
</style>
