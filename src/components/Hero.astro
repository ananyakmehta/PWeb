---
// DD_v2.1.md §4.1 — REVISED from v2: full 50/50 split hero (not a compact header), the
// photo large and dominant on the left rather than a small inset avatar. Sits on the
// reactive halftone background (§5.1) via the shared Layout.
//
// RESPONSIVE CHOICE (flagged per the doc's explicit ask — "Claude Code's reasonable
// call, flag which was chosen"): stacks at <=720px with the photo ON TOP and text
// below. Reasoning: leading with the person's face reads better for a personal
// portfolio than leading with a paragraph of filler text on a phone screen. Easy to
// flip if the owner prefers text-first on mobile.
import { Image } from 'astro:assets';
import photo from '../assets/hero/photo.svg';
import { buildLoopTrail } from '../lib/planeTrail';

const links = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'Email', href: '#' },
];

// Small cute white-outline paper planes with dotted loop-de-loop trails, "flying in"
// from off the left/right screen edges. 8 total, asymmetric — 4 per side, varied
// vertical position, loop size/turns, scale, and opacity rather than a mirrored grid.
// Each plane is its own small self-contained SVG (own viewBox "0 0 90 60") positioned
// absolutely via CSS with a negative left/right offset, so the trail's start point
// (near local x=0 or x=90) sits beyond the hero's actual edge — that's what makes the
// trail read as running off-screen rather than just starting near the border.
//
// Desktop-only: hidden below the same 720px breakpoint where the hero collapses to a
// stacked mobile layout, since these coordinates are authored against the 50/50 split
// and wouldn't correspond to anything sensible once the layout reflows.
const PLANE_CONFIGS = [
  // left side — flying in from the left edge, heading right/inward
  { side: 'left', top: '4%', width: 62, opacity: 0.4, start: [-6, 30], end: [60, 13], loopRadius: 9, loopTurns: 1.2, loopDir: 1 },
  { side: 'left', top: '26%', width: 50, opacity: 0.28, start: [-6, 8], end: [66, 40], loopRadius: 7, loopTurns: 1.05, loopDir: -1 },
  { side: 'left', top: '52%', width: 70, opacity: 0.34, start: [-6, 48], end: [58, 18], loopRadius: 10, loopTurns: 1.3, loopDir: 1 },
  { side: 'left', top: '76%', width: 46, opacity: 0.24, start: [-6, 20], end: [70, 50], loopRadius: 6, loopTurns: 1.0, loopDir: -1 },
  // right side — flying in from the right edge, heading left/inward
  { side: 'right', top: '2%', width: 64, opacity: 0.4, start: [96, 26], end: [28, 9], loopRadius: 9, loopTurns: 1.15, loopDir: -1 },
  { side: 'right', top: '30%', width: 48, opacity: 0.28, start: [96, 6], end: [22, 38], loopRadius: 7, loopTurns: 1.1, loopDir: 1 },
  { side: 'right', top: '58%', width: 74, opacity: 0.36, start: [96, 46], end: [34, 16], loopRadius: 10.5, loopTurns: 1.25, loopDir: -1 },
  { side: 'right', top: '82%', width: 44, opacity: 0.22, start: [96, 20], end: [20, 48], loopRadius: 6.5, loopTurns: 1.0, loopDir: 1 },
].map((p) => {
  const { pathD, endAngleDeg } = buildLoopTrail({
    startX: p.start[0],
    startY: p.start[1],
    endX: p.end[0],
    endY: p.end[1],
    loopRadius: p.loopRadius,
    loopTurns: p.loopTurns,
    loopDirection: p.loopDir as 1 | -1,
  });
  return { ...p, pathD, endAngleDeg, endX: p.end[0], endY: p.end[1] };
});
---

<header class="hero">
  <div class="plane-field" aria-hidden="true">
    {
      PLANE_CONFIGS.map((p) => (
        <svg
          class={`plane plane-${p.side}`}
          style={`top:${p.top}; ${p.side}:-${Math.round(p.width * 0.32)}px; width:${p.width}px; opacity:${p.opacity};`}
          viewBox="0 0 90 60"
        >
          <path d={p.pathD} class="plane-trail" />
          <g transform={`translate(${p.endX},${p.endY}) rotate(${p.endAngleDeg.toFixed(1)})`}>
            <path
              class="plane-icon"
              d="M0,0 L-14,-6 L-8,0 L-14,6 Z M0,0 L-8,0"
            />
          </g>
        </svg>
      ))
    }
  </div>

  <div class="hero-photo-col">
    <Image
      src={photo}
      alt="Placeholder profile photo"
      width={1000}
      height={1250}
      class="hero-photo"
    />
  </div>

  <div class="hero-text-col">
    <h1>Hi, I'm [Name] — placeholder hero copy.</h1>
    <p class="filler">
      [Placeholder text] Line two of the filler bio goes here, casual in tone rather
      than a LinkedIn headline.
    </p>
    <p class="filler">[Placeholder text] Line three wraps up the filler introduction.</p>

    <nav class="link-row" aria-label="Contact and profile links">
      {
        links.map((l) => (
          <a href={l.href} class="link-pill">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: 82vh;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero-photo-col {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    max-height: 74vh;
    object-fit: cover;
    border-radius: 16px;
  }

  .hero-text-col {
    position: relative;
  }

  h1 {
    margin: 0 0 0.8rem;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .filler {
    margin: 0 0 0.5rem;
    color: var(--page-text-dim);
    max-width: 46ch;
    font-size: 1.05rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .link-pill {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    transition: background 150ms ease, color 150ms ease;
  }

  .link-pill:hover {
    background: var(--chip-bg-hover);
    color: var(--chip-text-hover);
  }

  /* Restrained decorative accents — small, not a focal element, sit above the photo
     and text at low opacity rather than competing with either. */
  .plane-field {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .plane {
    position: absolute;
    height: auto;
    overflow: visible;
  }

  .plane-trail {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 1.5 4.5;
  }

  .plane-icon {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  @media (max-width: 720px) {
    /* Coordinates are authored against the 50/50 desktop split — they wouldn't
       correspond to anything sensible once the hero collapses to a single stacked
       column, so the whole decorative layer is hidden rather than reflowed. */
    .plane-field {
      display: none;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 1.75rem;
      padding: 1.5rem 1.5rem 2.5rem;
    }

    .hero-photo-col {
      order: 1;
    }

    .hero-photo {
      max-height: 50vh;
    }

    .hero-text-col {
      order: 2;
    }

    h1 {
      font-size: 1.9rem;
    }
  }
</style>
