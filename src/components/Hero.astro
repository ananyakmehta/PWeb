---
// DD_v2.1.md §4.1 — REVISED from v2: full 50/50 split hero (not a compact header), the
// photo large and dominant on the left rather than a small inset avatar. Sits on the
// reactive halftone background (§5.1) via the shared Layout.
//
// RESPONSIVE CHOICE (flagged per the doc's explicit ask — "Claude Code's reasonable
// call, flag which was chosen"): stacks at <=720px with the photo ON TOP and text
// below. Reasoning: leading with the person's face reads better for a personal
// portfolio than leading with a paragraph of filler text on a phone screen. Easy to
// flip if the owner prefers text-first on mobile.
import { Image } from 'astro:assets';
import photo from '../assets/hero/photo.svg';

const links = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'Email', href: '#' },
];
---

<header class="hero">
  <div class="hero-photo-col">
    <Image
      src={photo}
      alt="Placeholder profile photo"
      width={1000}
      height={1250}
      class="hero-photo"
    />
  </div>

  <div class="hero-text-col">
    <h1>Hi, I'm [Name] — placeholder hero copy.</h1>
    <p class="filler">
      [Placeholder text] Line two of the filler bio goes here, casual in tone rather
      than a LinkedIn headline.
    </p>
    <p class="filler">[Placeholder text] Line three wraps up the filler introduction.</p>

    <nav class="link-row" aria-label="Contact and profile links">
      {
        links.map((l) => (
          <a href={l.href} class="link-pill">
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 3rem;
    min-height: 82vh;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .hero-photo-col {
    height: 100%;
    display: flex;
    align-items: center;
  }

  .hero-photo {
    width: 100%;
    height: auto;
    max-height: 74vh;
    object-fit: cover;
    border-radius: 16px;
  }

  .hero-text-col {
    position: relative;
  }

  h1 {
    margin: 0 0 0.8rem;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .filler {
    margin: 0 0 0.5rem;
    color: var(--page-text-dim);
    max-width: 46ch;
    font-size: 1.05rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .link-pill {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    transition: background 150ms ease, color 150ms ease;
  }

  .link-pill:hover {
    background: var(--chip-bg-hover);
    color: var(--chip-text-hover);
  }

  @media (max-width: 720px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: 1.75rem;
      padding: 1.5rem 1.5rem 2.5rem;
    }

    .hero-photo-col {
      order: 1;
    }

    .hero-photo {
      max-height: 50vh;
    }

    .hero-text-col {
      order: 2;
    }

    h1 {
      font-size: 1.9rem;
    }
  }
</style>
