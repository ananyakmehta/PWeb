---
// Hero redesign (direct instruction, replacing the previous "shrink into a small
// centered banner" end state): on load the hero is a full-viewport photo mosaic
// (irregular tile sizes, hand-tiled to cover the screen edge-to-edge with no gaps —
// not a uniform grid), same as before. Scrolling now rearranges the same 6 tiles into
// an OUTLINE around the hero text instead — a band across the top plus bands down the
// left/right sides, still full-bleed edge-to-edge, deliberately leaving the bottom
// open (no band there) and the center open for the text. The frame itself never
// shrinks or moves off to one side; it stays full-viewport throughout — only the
// tiles' own positions within it change, from the mosaic arrangement to the outline
// arrangement. The hero text now lives inside that open center, fading in as the
// outline forms rather than arriving afterward as a separate section.
//
// Progressive enhancement, not a single fixed implementation: the DOM/default CSS
// renders a plain static END state — a compact banner row above the text, in normal
// document flow — unconditionally. That's what a user gets with no JS, reduced
// motion, or a narrow viewport; a full-viewport scroll-pinned outline isn't something
// a static fallback can reasonably approximate, so it deliberately falls back to the
// simpler treatment instead. JS only *upgrades* it into the scroll-linked pinned
// outline when motion is allowed and the viewport is wide enough (matches the same
// 720px breakpoint used elsewhere for desktop-only effects).
import { Image } from 'astro:assets';
import tileA from '../assets/hero/mosaic/A.svg';
import tileB from '../assets/hero/mosaic/B.svg';
import tileC from '../assets/hero/mosaic/C.svg';
import tileD from '../assets/hero/mosaic/D.svg';
import tileE from '../assets/hero/mosaic/E.svg';
import tileF from '../assets/hero/mosaic/F.svg';

const links = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'Email', href: '#' },
];

// Outline geometry, in % of the (always full-viewport, in live mode) frame — single
// source of truth for both the tiles' target positions below and the open center
// rect .hero-copy is positioned into (passed to <style> via define:vars, so neither
// copy can drift out of sync with the other).
const TOP_H = 20; // top band height
const SIDE_W = 14; // left/right band width
const SIDE_SPAN = (100 - TOP_H) / 2; // height of each side-band tile (2 tiles stack per side)

// Mosaic layout: a hand-tiled partition of a 6-col x 4-row grid into 6 rectangles of
// varied size (no uniform grid, no gaps/overlaps — verified by hand), unchanged from
// before. Outline layout: 2 tiles form the top band (split left/right halves), 2 form
// the left band (stacked top/bottom halves), 2 form the right band (same) — deliberately
// no bottom band, and nothing covering the center where hero-copy sits. JS interpolates
// each tile's left/top/width/height between these two states as % of the frame's own
// box; since the frame stays a fixed full-viewport size throughout (see .mosaic-frame
// below), that's the only interpolation this effect needs.
const TILE_CONFIGS = [
  {
    id: 'A',
    src: tileA,
    mosaic: { left: 0, top: 0, width: 50, height: 50 },
    outline: { left: 0, top: 0, width: 50, height: TOP_H },
  },
  {
    id: 'B',
    src: tileB,
    mosaic: { left: 0, top: 50, width: 16.667, height: 50 },
    outline: { left: 0, top: TOP_H, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'C',
    src: tileC,
    mosaic: { left: 16.667, top: 50, width: 33.333, height: 50 },
    outline: { left: 0, top: TOP_H + SIDE_SPAN, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'D',
    src: tileD,
    mosaic: { left: 50, top: 0, width: 50, height: 25 },
    outline: { left: 50, top: 0, width: 50, height: TOP_H },
  },
  {
    id: 'E',
    src: tileE,
    mosaic: { left: 50, top: 25, width: 33.333, height: 75 },
    outline: { left: 100 - SIDE_W, top: TOP_H, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'F',
    src: tileF,
    mosaic: { left: 83.333, top: 25, width: 16.667, height: 75 },
    outline: { left: 100 - SIDE_W, top: TOP_H + SIDE_SPAN, width: SIDE_W, height: SIDE_SPAN },
  },
];
---

<div class="hero-pinzone" id="heroPinzone">
  <div class="hero-sticky">
    <div class="mosaic-frame" id="mosaicFrame">
      {
        TILE_CONFIGS.map((t) => (
          <div
            class="mosaic-tile"
            data-tile={t.id}
            data-mosaic={JSON.stringify(t.mosaic)}
            data-outline={JSON.stringify(t.outline)}
          >
            <Image src={t.src} alt="" width={900} height={700} />
          </div>
        ))
      }
    </div>

    <div class="hero-copy" id="heroCopy">
      <div class="hero-copy-inner">
        <h1>Hi, I'm [Name] — placeholder hero copy.</h1>
        <p class="filler">
          [Placeholder text] Line two of the filler bio goes here, casual in tone rather
          than a LinkedIn headline.
        </p>
        <p class="filler">[Placeholder text] Line three wraps up the filler introduction.</p>

        <nav class="link-row" aria-label="Contact and profile links">
          {
            links.map((l) => (
              <a href={l.href} class="link-pill">
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</div>

<style define:vars={{ topH: `${TOP_H}%`, sideW: `${SIDE_W}%` }}>
  /* Default / fallback state: a plain static banner above the text, in normal flow,
     no JS required. This is what no-JS, reduced-motion, and mobile all get — see the
     file-level comment on why this doesn't try to approximate the outline. */
  .hero-pinzone {
    height: auto;
    /* Breakout: index.astro nests Hero inside .page-body's max-width:1200px wrapper
       (for SpaceDecor's positioning), but the mosaic needs to span the TRUE viewport
       edge-to-edge, not just 1200px — the whole point of the outline is that it
       reaches the real edges. This standard full-bleed trick extends it back to the
       real viewport width regardless of the ancestor's constraint; .mosaic-frame's
       own max-width:1200px (below) still keeps the fallback banner correctly
       centered within it. */
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-sticky {
    position: static;
    height: auto;
  }

  .mosaic-frame {
    position: relative;
    display: flex;
    width: 100%;
    max-width: 1200px;
    height: 280px;
    margin: 2rem auto 0;
    border-radius: 16px;
    overflow: hidden;
  }

  .mosaic-tile {
    position: relative;
    flex: 1;
  }

  .mosaic-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* JS-enhanced state (class added by the script below, only when motion is allowed
     and the viewport is wide enough): tall scroll runway + sticky pin. Unlike the
     previous banner version, the frame itself never resizes — it's full-viewport for
     the entire pinned duration (see .mosaic-frame below); only the tiles inside it
     move, from the mosaic arrangement to the outline arrangement. That also means the
     sticky box's own height can just be 100vh again (no drift risk between a
     JS-computed height and this CSS value like the old banner version had to manage —
     there's nothing to compute, this box's content always fills it exactly). */
  .hero-pinzone.mosaic-live {
    height: 200vh;
  }

  .hero-pinzone.mosaic-live .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero-pinzone.mosaic-live .mosaic-frame {
    position: absolute;
    inset: 0;
    /* inset:0 alone doesn't stretch this: the fallback rule above sets an explicit
       height:280px (and width:100% + max-width:1200px) that this rule doesn't
       otherwise touch, and an explicit height wins over inset for sizing an
       absolutely-positioned box. Overriding both explicitly is what actually makes
       it fill .hero-sticky (100vh) edge to edge. */
    width: 100%;
    height: 100%;
    display: block;
    max-width: none;
    margin: 0;
    border-radius: 0;
  }

  .hero-pinzone.mosaic-live .mosaic-tile {
    position: absolute;
    /* left/top/width/height set inline by the script, every frame */
  }

  .hero-copy {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-copy-inner {
    padding: 2.5rem 1.5rem 4rem;
  }

  /* Live mode: hero-copy becomes the absolutely-positioned open center of the
     outline — see TOP_H/SIDE_W in the frontmatter, passed through as --topH/--sideW
     so this rect always matches the tiles' own outline positions exactly. Flex
     centers .hero-copy-inner (which keeps its own max-width/left-aligned text
     unchanged) within that rect, both directions, rather than stretching the text
     itself across the full open width. Opacity is set inline by the script, fading
     in as the outline forms rather than being visible from progress 0. */
  .hero-pinzone.mosaic-live .hero-copy {
    position: absolute;
    left: var(--sideW);
    right: var(--sideW);
    top: var(--topH);
    bottom: 0;
    max-width: none;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    /* opacity set inline by the script */
  }

  .hero-pinzone.mosaic-live .hero-copy-inner {
    max-width: 700px;
    padding: 0 1.5rem;
  }

  h1 {
    margin: 0 0 0.8rem;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .filler {
    margin: 0 0 0.5rem;
    color: var(--page-text-dim);
    max-width: 46ch;
    font-size: 1.05rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .link-pill {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    transition: background 150ms ease, color 150ms ease;
  }

  .link-pill:hover {
    background: var(--chip-bg-hover);
    color: var(--chip-text-hover);
  }
</style>

<script>
  // Progressive-enhancement gate: only switch into the scroll-linked pin/outline mode
  // when motion is allowed AND the viewport is wide enough (matches the 720px
  // breakpoint used elsewhere for desktop-only effects — position:sticky + dynamic
  // viewport-height math is exactly the kind of thing that gets unreliable on mobile
  // Safari's address-bar-driven 100vh changes, so it isn't worth chasing there).
  const pinzone = document.getElementById('heroPinzone');
  const frame = document.getElementById('mosaicFrame');
  const heroCopy = document.getElementById('heroCopy');
  if (!pinzone || !frame || !heroCopy) throw new Error('Hero mosaic: expected elements not found');

  const tiles = Array.from(frame.querySelectorAll('.mosaic-tile'));
  const tileData = tiles.map((el) => ({
    el,
    mosaic: JSON.parse(el.dataset.mosaic ?? '{}'),
    outline: JSON.parse(el.dataset.outline ?? '{}'),
  }));

  const motionOk = () => !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const widthOk = () => window.innerWidth > 720;

  // Hero-copy stays fully transparent until the outline is a good way through
  // forming, then fades in over the rest of the scroll — text appearing over a
  // still-mostly-closed mosaic would just look like it's popping in over a photo.
  const TEXT_FADE_START = 0.3;

  function lerp(a, b, t) {
    return a + (b - a) * t;
  }

  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function update() {
    const rect = pinzone.getBoundingClientRect();
    const scrollableHeight = pinzone.offsetHeight - window.innerHeight;
    const raw = scrollableHeight > 0 ? -rect.top / scrollableHeight : 1;
    const progress = Math.min(1, Math.max(0, raw));
    const eased = easeInOutCubic(progress);

    for (const t of tileData) {
      t.el.style.left = `${lerp(t.mosaic.left, t.outline.left, eased)}%`;
      t.el.style.top = `${lerp(t.mosaic.top, t.outline.top, eased)}%`;
      t.el.style.width = `${lerp(t.mosaic.width, t.outline.width, eased)}%`;
      t.el.style.height = `${lerp(t.mosaic.height, t.outline.height, eased)}%`;
    }

    const textOpacity = Math.max(0, Math.min(1, (progress - TEXT_FADE_START) / (1 - TEXT_FADE_START)));
    heroCopy.style.opacity = textOpacity.toFixed(2);
  }

  let liveMode = false;
  let ticking = false;

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
      ticking = true;
    }
  }

  function syncMode() {
    const shouldBeLive = motionOk() && widthOk();
    if (shouldBeLive === liveMode) return;
    liveMode = shouldBeLive;

    if (liveMode) {
      pinzone.classList.add('mosaic-live');
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
    } else {
      pinzone.classList.remove('mosaic-live');
      window.removeEventListener('scroll', onScroll);
      frame.removeAttribute('style');
      heroCopy.removeAttribute('style');
      for (const t of tileData) t.el.removeAttribute('style');
    }
  }

  syncMode();
  window.addEventListener('resize', () => {
    syncMode();
    if (liveMode) update();
  });
  window
    .matchMedia('(prefers-reduced-motion: reduce)')
    .addEventListener('change', syncMode);
</script>
