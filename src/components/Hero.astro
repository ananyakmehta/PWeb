---
// Hero redesign (direct instruction, replacing the previous "shrink into a small
// centered banner" end state): on load the hero is a full-viewport photo mosaic
// (irregular tile sizes, hand-tiled to cover the screen edge-to-edge with no gaps —
// not a uniform grid), same as before. Scrolling now rearranges the same 6 tiles into
// an OUTLINE around the hero text instead — a band across the top plus bands down the
// left/right sides, still full-bleed edge-to-edge, deliberately leaving the bottom
// open (no band there) and the center open for the text. The frame itself never
// shrinks or moves off to one side; it stays full-viewport throughout — only the
// tiles' own positions within it change, from the mosaic arrangement to the outline
// arrangement. The hero text now lives inside that open center, fading in as the
// outline forms rather than arriving afterward as a separate section.
//
// Progressive enhancement, not a single fixed implementation: the DOM/default CSS
// renders a plain static END state — a compact banner row above the text, in normal
// document flow — unconditionally. That's what a user gets with no JS, reduced
// motion, or a narrow viewport; a full-viewport scroll-pinned outline isn't something
// a static fallback can reasonably approximate, so it deliberately falls back to the
// simpler treatment instead. JS only *upgrades* it into the scroll-linked pinned
// outline when motion is allowed and the viewport is wide enough (matches the same
// 720px breakpoint used elsewhere for desktop-only effects).
import { Image } from 'astro:assets';
import tileA from '../assets/hero/mosaic/A.svg';
import tileB from '../assets/hero/mosaic/B.svg';
import tileC from '../assets/hero/mosaic/C.svg';
import tileD from '../assets/hero/mosaic/D.svg';
import tileE from '../assets/hero/mosaic/E.svg';
import tileF from '../assets/hero/mosaic/F.svg';
import manSwinging from '../assets/decor/man-swinging.png';

const links = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'Email', href: '#' },
];

// Outline geometry, in % of the (always full-viewport, in live mode) frame — single
// source of truth for both the tiles' target positions below and the open center
// rect .hero-copy is positioned into (passed to <style> via define:vars, so neither
// copy can drift out of sync with the other).
const TOP_H = 20; // top band height
const SIDE_W = 14; // left/right band width
// The side bands stop BOTTOM_GAP short of the true bottom edge (rather than reaching
// all the way to 100%, like the top band and the sides' own outer edge do) — that gap
// is deliberate open space for the swing (below) to hang in. Without it, "attach to
// the bottom edge of the last image" would mean attaching at the *viewport's* own
// bottom edge, i.e. the swing would hang entirely off-screen with nothing below it to
// hang into — this pulls the last tile on each side back just enough to leave room.
const BOTTOM_GAP = 14;
const SIDE_SPAN = (100 - TOP_H - BOTTOM_GAP) / 2; // height of each side-band tile (2 tiles stack per side)
const LAST_SIDE_TILE_BOTTOM = TOP_H + SIDE_SPAN * 2; // == 100 - BOTTOM_GAP; where the swing attaches
const SWING_LEFT = SIDE_W / 2; // horizontal midpoint of the left band, in line with tile C's own center rather than pinned to the outer edge

// Mosaic layout: a hand-tiled partition of a 6-col x 4-row grid into 6 rectangles of
// varied size (no uniform grid, no gaps/overlaps — verified by hand), unchanged from
// before. Outline layout: 2 tiles form the top band (split left/right halves), 2 form
// the left band (stacked top/bottom halves), 2 form the right band (same) — deliberately
// no bottom band, and nothing covering the center where hero-copy sits. JS interpolates
// each tile's left/top/width/height between these two states as % of the frame's own
// box; since the frame stays a fixed full-viewport size throughout (see .mosaic-frame
// below), that's the only interpolation this effect needs.
const TILE_CONFIGS = [
  {
    id: 'A',
    src: tileA,
    mosaic: { left: 0, top: 0, width: 50, height: 50 },
    outline: { left: 0, top: 0, width: 50, height: TOP_H },
  },
  {
    id: 'B',
    src: tileB,
    mosaic: { left: 0, top: 50, width: 16.667, height: 50 },
    outline: { left: 0, top: TOP_H, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'C',
    src: tileC,
    mosaic: { left: 16.667, top: 50, width: 33.333, height: 50 },
    outline: { left: 0, top: TOP_H + SIDE_SPAN, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'D',
    src: tileD,
    mosaic: { left: 50, top: 0, width: 50, height: 25 },
    outline: { left: 50, top: 0, width: 50, height: TOP_H },
  },
  {
    id: 'E',
    src: tileE,
    mosaic: { left: 50, top: 25, width: 33.333, height: 75 },
    outline: { left: 100 - SIDE_W, top: TOP_H, width: SIDE_W, height: SIDE_SPAN },
  },
  {
    id: 'F',
    src: tileF,
    mosaic: { left: 83.333, top: 25, width: 16.667, height: 75 },
    outline: { left: 100 - SIDE_W, top: TOP_H + SIDE_SPAN, width: SIDE_W, height: SIDE_SPAN },
  },
];
---

<div class="hero-pinzone" id="heroPinzone">
  <div class="hero-sticky">
    <div class="mosaic-frame" id="mosaicFrame">
      {
        TILE_CONFIGS.map((t) => (
          <div
            class="mosaic-tile"
            data-tile={t.id}
            data-mosaic={JSON.stringify(t.mosaic)}
            data-outline={JSON.stringify(t.outline)}
          >
            <Image src={t.src} alt="" width={900} height={700} />
          </div>
        ))
      }
    </div>

    <!-- Real, sourced icon — not hand-drawn — per direct instruction: an adult figure
         (not a child), as minimalist as possible — a flat solid silhouette, not
         line-art. "Man Swinging" by Gan Khoon Lay, Noun Project, CC BY 3.0 (credited
         in Footer.astro). The source icon includes its own A-frame support, which
         competed with the illusion of hanging from the photo above it — per direct
         feedback, .swing-crop below crops that out via plain CSS (an oversized,
         negatively-offset copy of the same unmodified asset inside a fixed, clipped
         box; see the coordinates comment in the <style> block), keeping only the
         person, seat, and the short stub of rope nearest the seat — not a second
         asset, not any pixel-level editing, the exact same source PNG framed
         differently. That stub is what visually "attaches" to the tile's bottom edge
         once positioned there. -->
    <div class="swing" id="heroSwing" aria-hidden="true">
      <div class="swing-crop">
        <Image src={manSwinging} alt="" width={512} height={512} />
      </div>

      <!-- Fun easter egg, direct instruction, one of 4 identical placements on this
           page — see the shared-base comment in global.css's .konami-hint rule and
           src/lib/konamiHint.ts for how the hover-reveal itself works. Nested inside
           .swing specifically so it inherits the swing's own scroll-driven opacity
           (CSS compounds a child's opacity with its ancestors' — see global.css) —
           it literally cannot render even translucently outside the swing's own
           visible window, with no extra JS needed to enforce that. Positioned with
           simple offsets relative to .swing's own (already correctly placed) box
           rather than the frame-relative --swingTop/--swingLeft vars .swing itself
           uses, since as a descendant it doesn't need to re-derive that position. -->
      <p class="konami-hint konami-hint--swing" aria-hidden="true">konami code?</p>
    </div>

    <div class="hero-copy" id="heroCopy">
      <!-- Same pattern as the swing's own hint above: nested inside .hero-copy so it
           inherits hero-copy's own scroll-driven fade-in, positioned in its top-right
           corner (inside the outline's top/right bands, not overlapping them). -->
      <p class="konami-hint konami-hint--corner" aria-hidden="true">konami code?</p>

      <div class="hero-copy-inner">
        <h1>Hi, I'm [Name] — placeholder hero copy.</h1>
        <p class="filler">
          [Placeholder text] Line two of the filler bio goes here, casual in tone rather
          than a LinkedIn headline.
        </p>
        <p class="filler">[Placeholder text] Line three wraps up the filler introduction.</p>

        <nav class="link-row" aria-label="Contact and profile links">
          {
            links.map((l) => (
              <a href={l.href} class="link-pill">
                {l.label}
              </a>
            ))
          }
        </nav>

        <!-- Same pattern again, in normal document flow right after the link row
             (rather than absolutely positioned) so "right under the pills" holds
             regardless of how many links there are or how they wrap. -->
        <p class="konami-hint konami-hint--pills" aria-hidden="true">konami code?</p>
      </div>
    </div>
  </div>
</div>

<style define:vars={{ topH: `${TOP_H}%`, sideW: `${SIDE_W}%`, swingTop: `${LAST_SIDE_TILE_BOTTOM}%`, swingLeft: `${SWING_LEFT}%` }}>
  /* Default / fallback state: a plain static banner above the text, in normal flow,
     no JS required. This is what no-JS, reduced-motion, and mobile all get — see the
     file-level comment on why this doesn't try to approximate the outline. */
  .hero-pinzone {
    height: auto;
    /* Breakout: harmless no-op now that .page-body has no width constraint of its own
       (kept for robustness in case that changes again) — the mosaic needs to span the
       TRUE viewport edge-to-edge regardless, not whatever an ancestor happens to be
       constrained to. .mosaic-frame's own max-width:1200px (below) still keeps the
       fallback banner correctly centered within it. */
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }

  .hero-sticky {
    position: static;
    height: auto;
  }

  .mosaic-frame {
    position: relative;
    display: flex;
    width: 100%;
    max-width: 1200px;
    height: 280px;
    margin: 2rem auto 0;
    border-radius: 16px;
    overflow: hidden;
  }

  .mosaic-tile {
    position: relative;
    flex: 1;
  }

  .mosaic-tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* JS-enhanced state (class added by the script below, only when motion is allowed
     and the viewport is wide enough): tall scroll runway + sticky pin. Unlike the
     previous banner version, the frame itself never resizes — it's full-viewport for
     the entire pinned duration (see .mosaic-frame below); only the tiles inside it
     move, from the mosaic arrangement to the outline arrangement. That also means the
     sticky box's own height can just be 100vh again (no drift risk between a
     JS-computed height and this CSS value like the old banner version had to manage —
     there's nothing to compute, this box's content always fills it exactly). */
  .hero-pinzone.mosaic-live {
    height: 200vh;
  }

  .hero-pinzone.mosaic-live .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .hero-pinzone.mosaic-live .mosaic-frame {
    position: absolute;
    inset: 0;
    /* inset:0 alone doesn't stretch this: the fallback rule above sets an explicit
       height:280px (and width:100% + max-width:1200px) that this rule doesn't
       otherwise touch, and an explicit height wins over inset for sizing an
       absolutely-positioned box. Overriding both explicitly is what actually makes
       it fill .hero-sticky (100vh) edge to edge. */
    width: 100%;
    height: 100%;
    display: block;
    max-width: none;
    margin: 0;
    border-radius: 0;
  }

  .hero-pinzone.mosaic-live .mosaic-tile {
    position: absolute;
    /* left/top/width/height set inline by the script, every frame */
  }

  /* Not shown at all outside live mode — this is purely a flourish on the
     scroll-pinned outline effect, not something the static fallback needs to
     approximate (same call as SpaceDecor's old desktop-only decorations). */
  .swing {
    display: none;
  }

  /* Live mode: top edge pinned to --swingTop, which is exactly the last (bottom-most)
     left-side outline tile's own bottom edge (LAST_SIDE_TILE_BOTTOM in the
     frontmatter, same value that tile's own `outline.top + outline.height` resolves
     to) — the cropped rope-stub (see .swing-crop below) sits right at that seam,
     "attached" to the image above it, with the seat and figure hanging down into
     BOTTOM_GAP's reserved open space below. left is --swingLeft (SIDE_W/2, tile C's
     own horizontal midpoint) minus half the crop's own width (14px of its 28px), so
     the icon is actually centered on that midpoint rather than starting there — per
     direct feedback, it was sitting right at the outer edge before. Opacity set
     inline by the script: fades in late in the pin phase (paired with the outline
     finishing forming) and fades back out once you scroll past it. */
  .hero-pinzone.mosaic-live .swing {
    display: block;
    position: absolute;
    left: calc(var(--swingLeft) - 14px);
    top: var(--swingTop);
    z-index: 3;
    opacity: 0;
    pointer-events: none;
  }

  /* The crop itself: a fixed, clipped box showing a specific rectangle of the full
     (unmodified) source icon — everything below is just that source image, scaled up
     and shifted with negative offsets so the wanted rectangle lands inside this box
     and everything else (the A-frame) falls outside it and gets clipped. Coordinates
     were measured directly against the source PNG's own 512x512 pixel grid (crop
     rect x:175-355, y:255-460 — person + seat + the rope's last stretch down to the
     seat, no frame pixels anywhere in that rectangle) at a 0.1574 scale factor
     (28/180 — 1/3 of the original 0.4722 scale, per direct instruction to size it
     down): container 28x33px, source image rendered at 81x81px and shifted
     -28px/-40px. Change the scale by changing the container's width/height and
     recomputing the image size (512 * scale) and offsets (-175 * scale, -255 * scale)
     together — they're linked, not independent knobs. */
  .swing-crop {
    width: 28px;
    height: 33px;
    overflow: hidden;
    position: relative;
  }

  .swing-crop :global(img) {
    position: absolute;
    left: -28px;
    top: -40px;
    width: 81px;
    height: 81px;
    /* global.css sets `img { max-width: 100% }` sitewide, which — being a different
       property than width, not just lower specificity — still clamps this box's
       242px width down to its 85px-wide clipping container's own width regardless of
       the width rule above winning the cascade for `width` itself. Overriding
       max-width here is what actually lets the image render at its real size before
       the container clips it down to the intended crop. */
    max-width: none;
    display: block;
    /* Source PNG is black-on-transparent (Noun Project's export) — forced white to
       read against the dark open background it mostly sits over, rather than tinting
       via currentColor/fill, which doesn't apply to raster images. */
    filter: brightness(0) invert(1);
  }

  /* Shared sizing/layout for every .konami-hint instance on this page — rest-state
     opacity/color/pointer-events come from the global base rule (global.css); this
     component only adds what differs per instance below. .konami-hint--corner and
     --pills default to display:none outside live mode since their ancestor
     (.hero-copy) doesn't itself toggle display the way .swing does — .swing's own
     display:none already hides --swing's nested copy for free, so it doesn't need a
     rule here. */
  .konami-hint {
    text-align: center;
    font-size: 0.7rem;
    white-space: nowrap;
    z-index: 3;
  }

  .konami-hint--corner,
  .konami-hint--pills {
    display: none;
  }

  /* Centered under the swing: left:50%/translateX(-50%) centers this 100px-wide box
     on .swing's own horizontal center (a simple relative offset, since .swing is
     already positioned exactly where it needs to be via --swingLeft/--swingTop — as
     its descendant, this doesn't need to re-derive that); top:38px clears the 33px
     swing height plus a small gap. */
  .hero-pinzone.mosaic-live .konami-hint--swing {
    display: block;
    position: absolute;
    left: 50%;
    top: 38px;
    width: 100px;
    margin: 0;
    transform: translateX(-50%);
  }

  /* Top-right corner of the open center, inside the top/right outline bands rather
     than overlapping them. */
  .hero-pinzone.mosaic-live .konami-hint--corner {
    display: block;
    position: absolute;
    top: 0.5rem;
    right: 0.75rem;
    margin: 0;
  }

  /* Normal document flow, right after .link-row (below) — holds "right under the
     pills" regardless of how many links there are or whether they wrap. */
  .hero-pinzone.mosaic-live .konami-hint--pills {
    display: block;
    margin: 0.75rem 0 0;
    text-align: left;
  }

  .hero-copy {
    max-width: 700px;
    margin: 0 auto;
  }

  .hero-copy-inner {
    padding: 2.5rem 1.5rem 4rem;
  }

  /* Live mode: hero-copy becomes the absolutely-positioned open center of the
     outline — see TOP_H/SIDE_W in the frontmatter, passed through as --topH/--sideW
     so this rect always matches the tiles' own outline positions exactly.
     .hero-copy is a row-direction flex container (the default), so align-items is
     the CROSS axis (vertical) and justify-content is the MAIN axis (horizontal) —
     flex-start on both packs .hero-copy-inner into the top-left corner of the open
     rect instead of centering it in the (tall, and on the right, wide-open) box.
     Earlier this had align-items:center + justify-content:flex-start, which — for a
     row container — actually left the vertical centering fully in place (wrong axis)
     while only changing horizontal packing; that's why the top gap stayed big even
     after that "fix." .hero-copy-inner's own top padding (below) sets how far under
     the top band the text actually sits; its max-width controls how far right it
     reaches before the right-side gap (bumped up so it doesn't read as a big empty
     margin on that side). Opacity is set inline by the script, fading in as the
     outline forms rather than being visible from progress 0. */
  .hero-pinzone.mosaic-live .hero-copy {
    position: absolute;
    left: var(--sideW);
    right: var(--sideW);
    top: var(--topH);
    bottom: 0;
    max-width: none;
    margin: 0;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    z-index: 2;
    /* opacity set inline by the script */
  }

  .hero-pinzone.mosaic-live .hero-copy-inner {
    max-width: 900px;
    padding: 2.5rem 1.5rem 0;
  }

  h1 {
    margin: 0 0 0.8rem;
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .filler {
    margin: 0 0 0.5rem;
    color: var(--page-text-dim);
    max-width: 46ch;
    font-size: 1.05rem;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .link-pill {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    transition: background 150ms ease, color 150ms ease;
  }

  .link-pill:hover {
    background: var(--chip-bg-hover);
    color: var(--chip-text-hover);
  }
</style>

<script>
  // Progressive-enhancement gate: only switch into the scroll-linked pin/outline mode
  // when motion is allowed AND the viewport is wide enough (matches the 720px
  // breakpoint used elsewhere for desktop-only effects — position:sticky + dynamic
  // viewport-height math is exactly the kind of thing that gets unreliable on mobile
  // Safari's address-bar-driven 100vh changes, so it isn't worth chasing there).
  const pinzone = document.getElementById('heroPinzone');
  const frame = document.getElementById('mosaicFrame');
  const heroCopy = document.getElementById('heroCopy');
  const swing = document.getElementById('heroSwing');
  if (!pinzone || !frame || !heroCopy || !swing) {
    throw new Error('Hero mosaic: expected elements not found');
  }

  const tiles = Array.from(frame.querySelectorAll('.mosaic-tile'));
  const tileData = tiles.map((el) => ({
    el,
    mosaic: JSON.parse(el.dataset.mosaic ?? '{}'),
    outline: JSON.parse(el.dataset.outline ?? '{}'),
  }));

  const motionOk = () => !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const widthOk = () => window.innerWidth > 720;

  // Hero-copy stays fully transparent until the outline is a good way through
  // forming, then fades in over the rest of the scroll — text appearing over a
  // still-mostly-closed mosaic would just look like it's popping in over a photo.
  const TEXT_FADE_START = 0.3;

  // The swing fades in later than the text (closer to the outline actually being
  // finished, per "as the images rearrange into their border, fade in") and fades
  // back out once you scroll past the pinned phase, per "fade out as you scroll down
  // from there" — SWING_RELEASE_FADE_RANGE is how much of the *release* scroll
  // (after progress has already hit 1 and the pin is letting go) it takes to fully
  // disappear, not a fraction of the whole pinzone.
  const SWING_FADE_START = 0.65;
  const SWING_RELEASE_FADE_RANGE = 0.35;

  let swingVisibility = 0;

  function lerp(a, b, t) {
    return a + (b - a) * t;
  }

  function easeInOutCubic(t) {
    return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
  }

  function update() {
    const rect = pinzone.getBoundingClientRect();
    const scrollableHeight = pinzone.offsetHeight - window.innerHeight;
    // Unclamped: needed both for progress (0-1, the pin/outline phase) and for how far
    // *past* 1 we are once the pin has released (the release phase) — see overshoot
    // below, which drives the swing's fade-out.
    const raw = scrollableHeight > 0 ? -rect.top / scrollableHeight : 1;
    const progress = Math.min(1, Math.max(0, raw));
    const overshoot = Math.max(0, raw - 1);
    const eased = easeInOutCubic(progress);

    for (const t of tileData) {
      t.el.style.left = `${lerp(t.mosaic.left, t.outline.left, eased)}%`;
      t.el.style.top = `${lerp(t.mosaic.top, t.outline.top, eased)}%`;
      t.el.style.width = `${lerp(t.mosaic.width, t.outline.width, eased)}%`;
      t.el.style.height = `${lerp(t.mosaic.height, t.outline.height, eased)}%`;
    }

    const textOpacity = Math.max(0, Math.min(1, (progress - TEXT_FADE_START) / (1 - TEXT_FADE_START)));
    heroCopy.style.opacity = textOpacity.toFixed(2);

    const swingFadeIn = Math.max(0, Math.min(1, (progress - SWING_FADE_START) / (1 - SWING_FADE_START)));
    const swingFadeOut = 1 - Math.max(0, Math.min(1, overshoot / SWING_RELEASE_FADE_RANGE));
    swingVisibility = swingFadeIn * swingFadeOut;
    swing.style.opacity = swingVisibility.toFixed(2);
  }

  let liveMode = false;
  let ticking = false;

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
      ticking = true;
    }
  }

  function syncMode() {
    const shouldBeLive = motionOk() && widthOk();
    if (shouldBeLive === liveMode) return;
    liveMode = shouldBeLive;

    if (liveMode) {
      pinzone.classList.add('mosaic-live');
      window.addEventListener('scroll', onScroll, { passive: true });
      update();
    } else {
      pinzone.classList.remove('mosaic-live');
      window.removeEventListener('scroll', onScroll);
      frame.removeAttribute('style');
      heroCopy.removeAttribute('style');
      swing.removeAttribute('style');
      for (const t of tileData) t.el.removeAttribute('style');
    }
  }

  syncMode();
  window.addEventListener('resize', () => {
    syncMode();
    if (liveMode) update();
  });
  window
    .matchMedia('(prefers-reduced-motion: reduce)')
    .addEventListener('change', syncMode);
</script>
