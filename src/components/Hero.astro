---
// DD_v2.md §4.1 — casual tone, restrained decorative accents. The constellation
// background (§5.1) is now the site's one signature visual element, so the hero stays
// quiet rather than competing with it. Description text is filler; the human will
// write real copy in a later pass. No filter bar below anymore (v1 had one) — the hero
// transitions directly into the project list.
import { Image } from 'astro:assets';
import photo from '../assets/hero/photo.svg';

const links = [
  { label: 'GitHub', href: '#' },
  { label: 'LinkedIn', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'Email', href: '#' },
];
---

<header class="hero">
  <span class="plane plane-a" aria-hidden="true">✈</span>
  <span class="plane plane-b" aria-hidden="true">✈</span>

  <div class="hero-inner">
    <Image src={photo} alt="Placeholder profile photo" width={160} height={160} class="hero-photo" />

    <div class="hero-copy">
      <h1>Hi, I'm [Name] — placeholder hero copy.</h1>
      <p class="filler">
        [Placeholder text] Line two of the filler bio goes here, casual in tone rather
        than a LinkedIn headline.
      </p>
      <p class="filler">[Placeholder text] Line three wraps up the filler introduction.</p>

      <nav class="link-row" aria-label="Contact and profile links">
        {
          links.map((l) => (
            <a href={l.href} class="link-pill">
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 4rem 1.5rem 2rem;
    max-width: 960px;
    margin: 0 auto;
    overflow: hidden;
  }

  .hero-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-photo {
    border-radius: 50%;
    flex-shrink: 0;
  }

  .hero-copy {
    flex: 1;
    min-width: 260px;
  }

  h1 {
    margin: 0 0 0.6rem;
    font-size: 1.9rem;
    font-weight: 700;
  }

  .filler {
    margin: 0 0 0.4rem;
    color: var(--page-text-dim);
    max-width: 46ch;
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }

  .link-pill {
    text-decoration: none;
    font-size: 0.85rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    transition: background 150ms ease, color 150ms ease;
  }

  .link-pill:hover {
    background: var(--chip-bg-hover);
    color: var(--chip-text-hover);
  }

  /* Restrained decorative accents — small, not a focal element (§4). */
  .plane {
    position: absolute;
    font-size: 1.1rem;
    opacity: 0.35;
    color: var(--page-text-dim);
    pointer-events: none;
  }

  .plane-a {
    top: 1.2rem;
    right: 8%;
    transform: rotate(20deg);
  }

  .plane-b {
    top: 5.5rem;
    right: 18%;
    transform: rotate(35deg) scale(0.7);
    opacity: 0.2;
  }
</style>
