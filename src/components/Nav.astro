---
// Nav rebuild, direct instruction — mirrors the reference site's (davisryan.tech) top
// layout exactly: brand/name far left, primary nav links centered, icon row far
// right — transparent background (no bar/fill/blur), not the previous translucent
// sticky bar. Icon set is the one explicit override from the reference: LinkedIn,
// Email, Résumé, GitHub instead of its social icons.
//
// LinkedIn/GitHub use their actual official marks (exact paths from Simple Icons,
// CC0-1.0 — see those two <svg> blocks below for the license note). Email/Résumé
// aren't brand logos — there's no "official" icon for either — so those stay as
// simple hand-drawn line art (envelope, document) rather than trying to fetch
// something that doesn't exist.
import { withBase } from '../lib/url';

const centerLinks = [
  { label: 'Home', href: withBase('') },
  { label: 'Projects', href: withBase('#projects') },
];

const icons = [
  { label: 'LinkedIn', href: '#' },
  { label: 'Email', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'GitHub', href: '#' },
];
---

<nav class="site-nav" aria-label="Primary">
  <a class="wordmark" href={withBase('')}>[Name]</a>

  <div class="center-links">
    {
      centerLinks.map((l) => (
        <a class="nav-link" href={l.href}>
          {l.label}
        </a>
      ))
    }
  </div>

  <div class="icon-links">
    {
      icons.map((i) => (
        <a class="icon-link" href={i.href} aria-label={i.label} title={i.label}>
          {i.label === 'LinkedIn' && (
            // Official mark, exact path from Simple Icons (CC0-1.0) — fetched directly
            // rather than reconstructed from memory, since a slightly-wrong path here
            // would render as a garbled shape instead of a recognizable logo.
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
            </svg>
          )}
          {i.label === 'Email' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
              <path d="M3 5.5l7 5.5 7-5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {i.label === 'Résumé' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 2h7l4 4v12H5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M12 2v4h4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <line x1="7.5" y1="11" x2="14.5" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              <line x1="7.5" y1="14" x2="14.5" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            </svg>
          )}
          {i.label === 'GitHub' && (
            // Official mark, exact path from Simple Icons (CC0-1.0) — same reasoning
            // as LinkedIn above: fetched, not reconstructed from memory.
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          )}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    /* Transparent, not a bar — floats directly over whatever's behind it (the hero
       mosaic, the halftone background further down), matching the reference site
       rather than the translucent-blurred bar this had before. */
    background: transparent;
  }

  .wordmark {
    justify-self: start;
    text-decoration: none;
    color: var(--page-text);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .center-links {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--page-text-dim);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .icon-links {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .icon-link {
    color: var(--page-text-dim);
    line-height: 0;
    transition: color 150ms ease;
  }

  .icon-link:hover {
    color: var(--accent);
  }

  .icon-link svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  @media (max-width: 640px) {
    .site-nav {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1.5rem;
      text-align: center;
    }

    .wordmark,
    .center-links,
    .icon-links {
      justify-self: center;
    }
  }
</style>
