---
// Nav rebuild, direct instruction — mirrors the reference site's (davisryan.tech) top
// layout exactly: brand/name far left, primary nav links centered, icon row far
// right — transparent background (no bar/fill/blur), not the previous translucent
// sticky bar. Icon set is the one explicit override from the reference: LinkedIn,
// Email, Résumé, GitHub instead of its social icons.
import { withBase } from '../lib/url';

const centerLinks = [
  { label: 'Home', href: withBase('') },
  { label: 'Projects', href: withBase('#projects') },
];

const icons = [
  { label: 'LinkedIn', href: '#' },
  { label: 'Email', href: '#' },
  { label: 'Résumé', href: '#' },
  { label: 'GitHub', href: '#' },
];
---

<nav class="site-nav" aria-label="Primary">
  <a class="wordmark" href={withBase('')}>[Name]</a>

  <div class="center-links">
    {
      centerLinks.map((l) => (
        <a class="nav-link" href={l.href}>
          {l.label}
        </a>
      ))
    }
  </div>

  <div class="icon-links">
    {
      icons.map((i) => (
        <a class="icon-link" href={i.href} aria-label={i.label} title={i.label}>
          {i.label === 'LinkedIn' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="2" width="16" height="16" rx="3" stroke="currentColor" stroke-width="1.4" />
              <circle cx="6.5" cy="7" r="0.9" fill="currentColor" />
              <line x1="6.5" y1="9.5" x2="6.5" y2="14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
              <path d="M10 14.5V10.5Q10 9 11.5 9Q13 9 13 10.5V14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              <line x1="10" y1="9.5" x2="10" y2="14.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
          )}
          {i.label === 'Email' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="2" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
              <path d="M3 5.5l7 5.5 7-5.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          )}
          {i.label === 'Résumé' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 2h7l4 4v12H5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <path d="M12 2v4h4" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
              <line x1="7.5" y1="11" x2="14.5" y2="11" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
              <line x1="7.5" y1="14" x2="14.5" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
            </svg>
          )}
          {i.label === 'GitHub' && (
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.4" />
              <path
                d="M7 12c-1.2.3-1.6-.5-2-1M13 15v-1.6c0-.5.2-.9.5-1.2-1.7-.2-3.5-.9-3.5-3.8 0-.8.3-1.5.8-2.1-.1-.2-.3-1 .1-2.1 0 0 .7-.2 2.1.8a7 7 0 0 1 3.8 0c1.4-1 2.1-.8 2.1-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 2.9-1.8 3.6-3.5 3.8.3.3.5.8.5 1.4V15"
                stroke="currentColor"
                stroke-width="1.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
    /* Transparent, not a bar — floats directly over whatever's behind it (the hero
       mosaic, the halftone background further down), matching the reference site
       rather than the translucent-blurred bar this had before. */
    background: transparent;
  }

  .wordmark {
    justify-self: start;
    text-decoration: none;
    color: var(--page-text);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .center-links {
    justify-self: center;
    display: flex;
    align-items: center;
    gap: 2.25rem;
  }

  .nav-link {
    text-decoration: none;
    color: var(--page-text-dim);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    transition: color 150ms ease;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .icon-links {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .icon-link {
    color: var(--page-text-dim);
    line-height: 0;
    transition: color 150ms ease;
  }

  .icon-link:hover {
    color: var(--accent);
  }

  .icon-link svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  @media (max-width: 640px) {
    .site-nav {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1.5rem;
      text-align: center;
    }

    .wordmark,
    .center-links,
    .icon-links {
      justify-self: center;
    }
  }
</style>
