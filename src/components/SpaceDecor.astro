const SATURN_VIEWBOX = '0 0 122.88 97.05';

// Native viewBox 0 0 512 273.23. A cluster of 3 stars (one solid, two hollow via the
// path's own nonzero fill rule) — see the licensing comment above for why this stands
// in for "constellation".
const CONSTELLATION_PATH =
  'm404.63 17.77 26.89 62.95 68.58 6.13c3.52.42 6.6 2.19 8.74 4.73 2.15 2.56 3.35 5.9 3.13 9.44l-.07.85c-.2 1.6-.67 3.11-1.36 4.48l-.32.57c-.59 1.03-1.32 1.98-2.15 2.81l-52.28 45.69 15.26 66.77c.84 3.62.11 7.27-1.73 10.19-1.83 2.9-4.8 5.14-8.43 5.96-1.79.4-3.62.43-5.36.12-1.69-.3-3.3-.93-4.74-1.83l-58.58-35.01-27.34 16.34-3.63-15.61 27.01-16.15a7.633 7.633 0 0 1 7.88-.03l59.09 35.32-15.34-67.1c-.59-2.66.23-5.54 2.42-7.46l51.85-45.27-68.1-6.12a7.621 7.621 0 0 1-6.8-4.64l-27.04-63.3-17.94 42.02-16.02-1.44 21.55-50.45c1.45-3.42 4.16-5.93 7.36-7.22 3.21-1.3 6.91-1.36 10.34.1l.59.28c1.4.67 2.64 1.57 3.66 2.6 1.23 1.19 2.19 2.67 2.88 4.28zM262.89 4.59l36.63 85.78 92.92 8.34c4.1.35 7.14 3.96 6.78 8.06-.17 2-1.12 3.74-2.52 4.96l-70.29 61.38 20.79 90.99c.93 4.01-1.59 8.02-5.61 8.94-2.05.47-4.11.04-5.75-1.03L256 224.27l-80.1 47.89c-3.53 2.11-8.1.96-10.22-2.58a7.365 7.365 0 0 1-.87-5.48l-.01-.01 20.8-90.98-70.3-61.38a7.445 7.445 0 0 1-.7-10.52 7.448 7.448 0 0 1 5.21-2.53l92.67-8.31 36.65-85.82c1.62-3.8 6-5.57 9.79-3.95 1.87.79 3.25 2.26 3.97 3.99zM119.79 27.6 92.75 90.9a7.61 7.61 0 0 1-6.8 4.64l-68.1 6.12 51.85 45.27a7.653 7.653 0 0 1 2.42 7.46l-15.33 67.1 59.08-35.32c2.51-1.5 5.53-1.39 7.88.03l27.05 16.17-3.57 15.65-27.44-16.4-58.58 35.02c-1.44.89-3.05 1.52-4.74 1.82-1.74.31-3.57.28-5.35-.12-3.65-.82-6.61-3.06-8.44-5.96-1.83-2.93-2.56-6.57-1.73-10.19l15.26-66.77-52.28-45.69c-.83-.83-1.56-1.78-2.15-2.81l-.31-.57c-.7-1.37-1.17-2.88-1.37-4.48l-.07-.82c-.22-3.56.98-6.9 3.13-9.47 2.14-2.55 5.22-4.31 8.75-4.73l68.57-6.13 26.89-62.95c.69-1.61 1.66-3.09 2.86-4.29 1.04-1.02 2.27-1.91 3.67-2.58l.61-.29c3.41-1.46 7.12-1.4 10.33-.11 3.2 1.3 5.91 3.81 7.36 7.23l21.54 50.43-16 1.44-17.95-42z';
const CONSTELLATION_VIEWBOX = '0 0 512 273.23';

// Native viewBox 0 0 512 489.255. Single 5-point outline star.
const STAR_PATH =
  'M278.56 16.223l59.371 139.027 152.968 13.689c6.245.681 11.71 3.801 15.512 8.326 3.833 4.52 5.956 10.445 5.537 16.752l-.082.976c-.935 9.261-5.16 12.903-10.264 17.294-37.836 32.687-75.389 65.812-113.055 98.705l34.123 149.312a23.633 23.633 0 01-3.012 17.825 23.583 23.583 0 01-14.793 10.543l-.595.119c-6.074 1.219-12.464.02-17.65-3.378l-130.623-78.112-131.443 78.587a23.6 23.6 0 01-17.899 2.655 23.638 23.638 0 01-14.546-10.822c-3.92-6.56-3.956-12.294-2.308-19.494l33.652-147.24L8.094 210.267a23.58 23.58 0 01-8.042-16.219 23.627 23.627 0 015.801-17.134c4.122-4.835 10.206-7.722 16.534-8.068l151.666-13.596L234.21 14.405c2.552-6.007 7.329-10.418 12.96-12.691a23.635 23.635 0 0118.094.175c6.963 2.96 10.429 7.604 13.296 14.334zm41.855 153.558L258.487 24.767c-.491-1.157-.925-2.107-1.255-2.526l-.511-.279a1.907 1.907 0 00-1.441-.01 1.847 1.847 0 00-.997.997l-62.714 146.832c-1.549 3.574-4.948 6.219-9.096 6.575L23.585 190.623c-.614.026-.831.258-1.27.62-.718.718-.62 1.973.129 2.629l119.785 104.584a10.912 10.912 0 013.947 11.054l-35.104 153.583c-.3 1.312-.532 2.412-.517 2.923l.264.517c.253.424.671.718 1.136.831.47.114.987.068 1.41-.185l136.894-81.841c3.352-2.071 7.717-2.252 11.332-.088l136.982 81.887c.186.124.429.223.687.264.165.072.367.067.594.036l.145-.036c.49-.109.898-.419 1.136-.796l.041-.041c.238-.382.336-.894.222-1.395l-35.574-155.654c-.847-3.781.341-7.898 3.461-10.63 39.335-34.35 78.54-68.953 118.05-103.086 1.477-1.276 2.707-2.33 2.8-3.141.083-1.053-.574-1.901-1.643-1.994l-158.355-14.251c-4.128-.124-8.002-2.588-9.722-6.632z';
const STAR_VIEWBOX = '0 0 512 489.255';

// Each item's real rendered height, as a multiple of its own `width` — used by
// layoutTrack() below to pack items with a guaranteed non-overlapping gap. Plane/
// planet/constellation/star ratios come straight from their SVG viewBox proportions;
// astronaut is padded above its actual square (512x512) image ratio to account for the
// flag, which is composited overlapping the top-right corner (see .astronaut-flag).
const ASPECT: Record<string, number> = {
  plane: 60 / 90,
  astronaut: 1.15,
  planet: 97.05 / 122.88,
  constellation: 273.23 / 512,
  star: 489.255 / 512,
};

// Measured rendered height of `.decorated-content` (index.astro) across the
// 1024-1440px desktop range this component is shown at: ~1436-1485px. A mid-range
// figure keeps this safe in both directions — see the file-level comment above.
const REFERENCE_HEIGHT = 1460;
const MIN_GAP = 40;

type DecorItem = {
  type: 'plane' | 'astronaut' | 'planet' | 'constellation' | 'star';
  side: 'left' | 'right';
  width: number;
  opacity: number;
  flip?: boolean;
  color?: string;
  start?: [number, number];
  end?: [number, number];
  loopRadius?: number;
  loopTurns?: number;
  loopDir?: 1 | -1;
};

// Stacks a track's items top-to-bottom with a minimum gap, then — since there's
// usually slack left in REFERENCE_HEIGHT once every item's real height is accounted
// for — spreads that slack evenly into every gap (including above the first item and
// below the last) rather than bunching everything at the top. Guarantees no overlap
// by construction: each item's `topPercent` sits strictly after the previous item's
// bottom edge plus the gap.
function layoutTrack<T extends { width: number; type: string }>(items: T[]) {
  const heights = items.map((it) => it.width * ASPECT[it.type]);
  const totalHeight = heights.reduce((sum, h) => sum + h, 0);
  const gapCount = items.length + 1;
  const gap = Math.max(MIN_GAP, (REFERENCE_HEIGHT - totalHeight) / gapCount);
  let cursor = gap;
  return items.map((it, i) => {
    const topPercent = (cursor / REFERENCE_HEIGHT) * 100;
    cursor += heights[i] + gap;
    return { ...it, topPercent };
  });
}

// Two independently-laid-out tracks (left/right edge), each mixing every decor type in
// an interleaved, non-grouped order for an organic/"random" feel rather than banding
// all the planes together, then all the astronauts, etc. Plane items carry their
// loop-trail config (start/end/loopRadius/loopTurns/loopDir); layoutTrack() only reads
// `width`/`type` and passes every other field through untouched.
const LEFT_ITEMS: DecorItem[] = [
  { type: 'plane', side: 'left', width: 105, opacity: 0.4, start: [-6, 30], end: [60, 13], loopRadius: 9, loopTurns: 1.2, loopDir: 1 },
  { type: 'star', side: 'left', width: 20, opacity: 0.35 },
  { type: 'astronaut', side: 'left', width: 52, opacity: 0.32, flip: false },
  { type: 'planet', side: 'left', width: 38, opacity: 0.3, color: '#e893c2' },
  { type: 'constellation', side: 'left', width: 56, opacity: 0.28 },
  { type: 'plane', side: 'left', width: 85, opacity: 0.28, start: [-6, 8], end: [66, 40], loopRadius: 7, loopTurns: 1.05, loopDir: -1 },
  { type: 'star', side: 'left', width: 22, opacity: 0.3 },
  { type: 'planet', side: 'left', width: 42, opacity: 0.28, color: '#6fd19a' },
  { type: 'astronaut', side: 'left', width: 54, opacity: 0.28, flip: false },
  { type: 'star', side: 'left', width: 18, opacity: 0.32 },
  { type: 'plane', side: 'left', width: 119, opacity: 0.34, start: [-6, 48], end: [58, 18], loopRadius: 10, loopTurns: 1.3, loopDir: 1 },
  { type: 'constellation', side: 'left', width: 52, opacity: 0.24 },
  { type: 'planet', side: 'left', width: 46, opacity: 0.34, color: '#e0736f' },
  { type: 'plane', side: 'left', width: 78, opacity: 0.24, start: [-6, 20], end: [70, 50], loopRadius: 6, loopTurns: 1.0, loopDir: -1 },
];

const RIGHT_ITEMS: DecorItem[] = [
  { type: 'plane', side: 'right', width: 109, opacity: 0.4, start: [96, 26], end: [28, 9], loopRadius: 9, loopTurns: 1.15, loopDir: -1 },
  { type: 'star', side: 'right', width: 24, opacity: 0.34 },
  { type: 'planet', side: 'right', width: 44, opacity: 0.34, color: '#e0736f' },
  { type: 'constellation', side: 'right', width: 58, opacity: 0.3 },
  { type: 'plane', side: 'right', width: 82, opacity: 0.28, start: [96, 6], end: [22, 38], loopRadius: 7, loopTurns: 1.1, loopDir: 1 },
  { type: 'astronaut', side: 'right', width: 59, opacity: 0.3, flip: true },
  { type: 'star', side: 'right', width: 20, opacity: 0.28 },
  { type: 'planet', side: 'right', width: 50, opacity: 0.32, color: '#a97fd1' },
  { type: 'plane', side: 'right', width: 126, opacity: 0.36, start: [96, 46], end: [34, 16], loopRadius: 10.5, loopTurns: 1.25, loopDir: -1 },
  { type: 'star', side: 'right', width: 22, opacity: 0.3 },
  { type: 'planet', side: 'right', width: 36, opacity: 0.3, color: '#e893c2' },
  { type: 'plane', side: 'right', width: 75, opacity: 0.22, start: [96, 20], end: [20, 48], loopRadius: 6.5, loopTurns: 1.0, loopDir: 1 },
];

const ALL_ITEMS = [...layoutTrack(LEFT_ITEMS), ...layoutTrack(RIGHT_ITEMS)];

const PLANE_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'plane').map((p) => {
  const { pathD, endAngleDeg } = buildLoopTrail({
    startX: p.start![0],
    startY: p.start![1],
    endX: p.end![0],
    endY: p.end![1],
    loopRadius: p.loopRadius!,
    loopTurns: p.loopTurns!,
    loopDirection: p.loopDir!,
  });
  return { ...p, pathD, endAngleDeg, endX: p.end![0], endY: p.end![1] };
});
const ASTRONAUT_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'astronaut');
const PLANET_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'planet');
const CONSTELLATION_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'constellation');
const STAR_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'star');
---

<div class="space-decor" aria-hidden="true">
  {
    PLANE_CONFIGS.map((p) => (
      <svg
        class={`plane plane-${p.side}`}
        style={`top:${p.topPercent.toFixed(2)}%; ${p.side}:-${Math.round(p.width * 0.32)}px; width:${p.width}px; opacity:${p.opacity};`}
        viewBox="0 0 90 60"
      >
        <path d={p.pathD} class="plane-trail" />
        <g
          transform={`translate(${p.endX},${p.endY}) rotate(${(p.endAngleDeg + PLANE_ROTATION_OFFSET).toFixed(1)}) scale(${PLANE_ICON_SCALE}) translate(${-PLANE_VIEWBOX_CENTER.x},${-PLANE_VIEWBOX_CENTER.y})`}
        >
          <path class="deco-icon" d={PLANE_PATH} />
        </g>
      </svg>
    ))
  }

  {
    ASTRONAUT_CONFIGS.map((a) => (
      <div
        class={`astronaut astronaut-${a.side}`}
        style={`top:${a.topPercent.toFixed(2)}%; ${a.side}:${Math.round(a.width * 0.1)}px; width:${a.width}px; opacity:${a.opacity}; ${a.flip ? 'transform:scaleX(-1);' : ''}`}
      >
        <Image src={astronautFloating} alt="" width={200} height={200} class="astronaut-img" />
        <svg class="astronaut-flag" viewBox={FLAG_VIEWBOX}>
          <path class="deco-icon" d={FLAG_PATH} />
        </svg>
      </div>
    ))
  }

  {
    PLANET_CONFIGS.map((p) => (
      <svg
        class={`planet planet-${p.side}`}
        style={`top:${p.topPercent.toFixed(2)}%; ${p.side}:${Math.round(p.width * 0.08)}px; width:${p.width}px; opacity:${p.opacity};`}
        viewBox={SATURN_VIEWBOX}
      >
        <path d={SATURN_PATH} style={`fill:${p.color};`} />
      </svg>
    ))
  }

  {
    CONSTELLATION_CONFIGS.map((c) => (
      <svg
        class={`constellation constellation-${c.side}`}
        style={`top:${c.topPercent.toFixed(2)}%; ${c.side}:${Math.round(c.width * 0.05)}px; width:${c.width}px; opacity:${c.opacity};`}
        viewBox={CONSTELLATION_VIEWBOX}
      >
        <path class="deco-icon" fill-rule="nonzero" d={CONSTELLATION_PATH} />
      </svg>
    ))
  }

  {
    STAR_CONFIGS.map((s) => (
      <svg
        class={`star star-${s.side}`}
        style={`top:${s.topPercent.toFixed(2)}%; ${s.side}:${Math.round(s.width * 0.15)}px; width:${s.width}px; opacity:${s.opacity};`}
        viewBox={STAR_VIEWBOX}
      >
        <path class="deco-icon" fill-rule="nonzero" d={STAR_PATH} />
      </svg>
    ))
  }
</div>

<style>
  .space-decor {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .plane,
  .astronaut,
  .planet,
  .constellation,
  .star {
    position: absolute;
    height: auto;
    overflow: visible;
  }

  .plane-trail {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 1.5 4.5;
  }

  .deco-icon {
    fill: #ffffff;
  }

  .astronaut-img {
    width: 100%;
    height: auto;
    display: block;
