---
// Decorative overlay: paper planes (dotted loop-de-loop trails, "flying in" from off
// the left/right screen edges), astronauts tumbling through space with flags, sparse
// colored planets, and small constellation clusters. Low-opacity, restrained.
//
// Icons are real marks, not hand-drawn — verified visually (rendered + screenshotted)
// before integrating in every case, since a wrong path/asset renders as a garbled
// shape, not something to trust from memory.
//   - Plane:         https://uxwing.com/paper-plane-icon/ (UXWing — no attribution needed)
//   - Astronaut:     https://thenounproject.com/icon/floating-astronaut-7644785/ by
//                    Andy Horvath, CC BY 3.0 — the one asset on this site that requires
//                    attribution (credited in Footer.astro). Searched UXWing/Flaticon/
//                    SVG Repo/Reshot/Tabler/unDraw/freesvg.org first for a
//                    no-attribution non-standing pose; none existed in a style that fit
//                    — this was the only actual match for "not standing" in a
//                    compatible monochrome style, and it's PNG raster (Noun Project
//                    gates SVG behind a paid API), not SVG like everything else here —
//                    tinted white via CSS filter (brightness(0) invert(1)) rather than
//                    currentColor/fill.
//   - Flag:          https://uxwing.com/flag-icon/  (astronaut has no flag built in;
//                    composited alongside it below, proportions tuned by eye)
//   - Planet:        https://uxwing.com/planet-saturn-space-icon/ — reused for all
//                    planet placements (varied size/opacity/color) rather than sourcing
//                    several different designs; same reuse-with-variation approach as
//                    the planes.
//   - Constellation: https://uxwing.com/stars-icon/ (UXWing, no attribution needed) — a
//                    small 3-star cluster. UXWing has no literal connect-the-dots
//                    constellation icon; this cluster is the closest real match in the
//                    same monochrome line-art style, used as the "constellation" motif.
//
// Hero-scoped exclusion: this component is placed inside `.decorated-content` in
// index.astro, a position:relative wrapper that starts AFTER the hero (Hero is a
// sibling outside it) rather than around the whole page. That's a structural
// guarantee, not a tuned coordinate — none of these graphics can land over the hero
// banner because the box they're positioned relative to doesn't include it.
//
// Layout: every item below is placed by `layoutTrack()`, not hand-picked percentages.
// It knows each item's real height (from its width and its icon's own aspect ratio),
// stacks the track's items top-to-bottom with a guaranteed minimum gap, and — since
// there's usually slack left over — spreads that slack evenly into every gap rather
// than leaving it bunched at the bottom. That's what "no overlap, okay spacing between
// each" is actually built from here, not eyeballed. REFERENCE_HEIGHT is the measured
// rendered height of `.decorated-content` (~1436-1485px across the 1024-1440px desktop
// range this component is shown at); using a mid-range figure keeps the percentage
// math safe in both directions — a shorter real render compresses gaps slightly, a
// taller one loosens them, neither one overlaps.
//
// Horizontal placement uses the same "compute from real geometry" approach, via
// `hOffset()` below — every item's card-facing edge targets roughly the same small
// inward reach (H_BASE_INSET, +/- a bit of per-item jitter for "varies a bit
// horizontally") regardless of the item's own width or type. The previous version used
// a different fixed multiplier of each item's width per type (planes at width*0.32,
// astronauts at width*0.1, etc.) — for the wider items that let the card-facing edge
// land 80px+ past the container's own edge, well past the project grid's 24px padding
// (project-list's own side padding — the tightest gutter between this overlay and the
// actual card content across every desktop width this shows at, since the extra
// centering margin from page-body's 1200px cap only exists once the viewport is wide
// enough to trigger it), which is what was actually causing the touching/overlap.
// Solving for a fixed target edge position instead of a width-scaled multiplier is what
// guarantees every item — regardless of size — stays clear of that gutter by the same
// margin.
//
// The wrapper needs a max-width with auto margins (not true edge-to-edge full viewport
// width) — the same trick the hero uses. Items poke slightly outside the wrapper's own
// box via negative left/right offsets (see hOffset()); as long as the wrapper is
// narrower than the viewport, that negative space lands in the real margin gutter
// (reading convincingly as "off-screen"), rather than pushing actual page content past
// x=0 and risking a horizontal scrollbar.
//
// Desktop-only: hidden below 720px, the same breakpoint where the hero collapses to a
// stacked mobile layout — these coordinates are authored against the wide desktop
// layout's edges and wouldn't line up with anything sensible on a narrow viewport.
import { Image } from 'astro:assets';
import { buildLoopTrail } from '../lib/planeTrail';
import astronautFloating from '../assets/decor/astronaut-floating.png';

// Native viewBox 0 0 122.88 103.44. Nose tip sits ~15-20deg above the horizontal-right
// axis at rest (checked by rendering it large with a crosshair overlay, not guessed) —
// PLANE_ROTATION_OFFSET corrects for that so the icon's nose actually follows its
// trail's direction of travel instead of trailing ~15-20deg off.
const PLANE_PATH =
  'M69.49,102.77L49.8,84.04l-20.23,18.27c-0.45,0.49-1.09,0.79-1.8,0.79c-1.35,0-2.44-1.09-2.44-2.44V60.77L0.76,37.41c-0.98-0.93-1.01-2.47-0.09-3.45c0.31-0.33,0.7-0.55,1.11-0.67l0,0l118-33.2c1.3-0.36,2.64,0.39,3.01,1.69c0.19,0.66,0.08,1.34-0.24,1.89l-49.2,98.42c-0.6,1.2-2.06,1.69-3.26,1.09C69.86,103.07,69.66,102.93,69.49,102.77L69.49,102.77L69.49,102.77z M46.26,80.68L30.21,65.42v29.76L46.26,80.68L46.26,80.68z M28.15,56.73l76.32-47.26L7.22,36.83L28.15,56.73L28.15,56.73z M114.43,9.03L31.79,60.19l38.67,36.78L114.43,9.03L114.43,9.03z';
const PLANE_VIEWBOX_CENTER = { x: 61.44, y: 51.72 };
const PLANE_ROTATION_OFFSET = 17;
const PLANE_ICON_SCALE = 0.15;

// Native viewBox 0 0 116.333 122.88. No pole-holding pose on the astronaut, so this is
// composited beside it rather than "held" — proportions (position/scale below) tuned
// by eye, re-checked against the new tumbling pose (was originally tuned for the old
// standing UXWing astronaut).
const FLAG_PATH =
  'M20.416,17.743c46.635-32.238,50.118,31.566,95.917-8.271v65.01c-43.681,39.279-53.104-24.185-95.917,8.068V17.743L20.416,17.743z M8.898,0c4.915,0,8.899,3.986,8.899,8.898c0,3.263-1.758,6.114-4.375,7.663h0.42v7.624v74.512v7.624h-0.42c2.617,1.549,4.375,3.574,4.375,7.662c0,4.087-3.984,8.896-8.899,8.896c-4.914,0-8.898-4.81-8.898-8.896c0-4.088,1.757-6.113,4.374-7.662H3.955v-7.624V24.185v-7.624h0.419C1.757,15.012,0,12.162,0,8.898C0,3.986,3.984,0,8.898,0L8.898,0z';
const FLAG_VIEWBOX = '0 0 116.333 122.88';

// Native viewBox 0 0 122.88 97.05.
const SATURN_PATH =
  'M37.11,6.51A48.54,48.54,0,0,1,93,11.68l.27-.08c7-1.78,13.15-2.53,17.89-2.16,5.17.4,8.9,2.15,10.7,5.37,3.25,5.79-1.07,14.76-10.66,24.58-.58.59-1.19,1.19-1.81,1.8A48.53,48.53,0,0,1,30.12,85.64c-.85.22-1.69.42-2.51.61-13.36,3.07-23.25,2.07-26.5-3.72l0,0c-1.81-3.25-1.32-7.39,1.1-12.07,2.17-4.2,6-9,11.07-14l.21-.2A48.56,48.56,0,0,1,37.11,6.51Zm67.72,38.83A195.18,195.18,0,0,1,72.24,67.91l-.06,0A195.65,195.65,0,0,1,36,84a43.59,43.59,0,0,0,68.82-38.62Zm-80.59,26c3.39-.43,11.31-3.54,20.77-7.86,6.22-2.83,13-6.28,19.61-10s13-7.61,18.67-11.44c8.34-5.69,14.77-10.83,16.59-13.9q-.37-.7-.78-1.41A43.57,43.57,0,0,0,23.64,70.31l.6,1Z';
const SATURN_VIEWBOX = '0 0 122.88 97.05';

// Native viewBox 0 0 512 273.23. A cluster of 3 stars (one solid, two hollow via the
// path's own nonzero fill rule) — see the licensing comment above for why this stands
// in for "constellation".
const CONSTELLATION_PATH =
  'm404.63 17.77 26.89 62.95 68.58 6.13c3.52.42 6.6 2.19 8.74 4.73 2.15 2.56 3.35 5.9 3.13 9.44l-.07.85c-.2 1.6-.67 3.11-1.36 4.48l-.32.57c-.59 1.03-1.32 1.98-2.15 2.81l-52.28 45.69 15.26 66.77c.84 3.62.11 7.27-1.73 10.19-1.83 2.9-4.8 5.14-8.43 5.96-1.79.4-3.62.43-5.36.12-1.69-.3-3.3-.93-4.74-1.83l-58.58-35.01-27.34 16.34-3.63-15.61 27.01-16.15a7.633 7.633 0 0 1 7.88-.03l59.09 35.32-15.34-67.1c-.59-2.66.23-5.54 2.42-7.46l51.85-45.27-68.1-6.12a7.621 7.621 0 0 1-6.8-4.64l-27.04-63.3-17.94 42.02-16.02-1.44 21.55-50.45c1.45-3.42 4.16-5.93 7.36-7.22 3.21-1.3 6.91-1.36 10.34.1l.59.28c1.4.67 2.64 1.57 3.66 2.6 1.23 1.19 2.19 2.67 2.88 4.28zM262.89 4.59l36.63 85.78 92.92 8.34c4.1.35 7.14 3.96 6.78 8.06-.17 2-1.12 3.74-2.52 4.96l-70.29 61.38 20.79 90.99c.93 4.01-1.59 8.02-5.61 8.94-2.05.47-4.11.04-5.75-1.03L256 224.27l-80.1 47.89c-3.53 2.11-8.1.96-10.22-2.58a7.365 7.365 0 0 1-.87-5.48l-.01-.01 20.8-90.98-70.3-61.38a7.445 7.445 0 0 1-.7-10.52 7.448 7.448 0 0 1 5.21-2.53l92.67-8.31 36.65-85.82c1.62-3.8 6-5.57 9.79-3.95 1.87.79 3.25 2.26 3.97 3.99zM119.79 27.6 92.75 90.9a7.61 7.61 0 0 1-6.8 4.64l-68.1 6.12 51.85 45.27a7.653 7.653 0 0 1 2.42 7.46l-15.33 67.1 59.08-35.32c2.51-1.5 5.53-1.39 7.88.03l27.05 16.17-3.57 15.65-27.44-16.4-58.58 35.02c-1.44.89-3.05 1.52-4.74 1.82-1.74.31-3.57.28-5.35-.12-3.65-.82-6.61-3.06-8.44-5.96-1.83-2.93-2.56-6.57-1.73-10.19l15.26-66.77-52.28-45.69c-.83-.83-1.56-1.78-2.15-2.81l-.31-.57c-.7-1.37-1.17-2.88-1.37-4.48l-.07-.82c-.22-3.56.98-6.9 3.13-9.47 2.14-2.55 5.22-4.31 8.75-4.73l68.57-6.13 26.89-62.95c.69-1.61 1.66-3.09 2.86-4.29 1.04-1.02 2.27-1.91 3.67-2.58l.61-.29c3.41-1.46 7.12-1.4 10.33-.11 3.2 1.3 5.91 3.81 7.36 7.23l21.54 50.43-16 1.44-17.95-42z';
const CONSTELLATION_VIEWBOX = '0 0 512 273.23';

// Each item's real rendered height, as a multiple of its own `width` — used by
// layoutTrack() below to pack items with a guaranteed non-overlapping gap. Plane/
// planet/constellation ratios come straight from their SVG viewBox proportions;
// astronaut is padded above its actual square (512x512) image ratio to account for the
// flag, which is composited overlapping the top-right corner (see .astronaut-flag).
const ASPECT: Record<string, number> = {
  plane: 60 / 90,
  astronaut: 1.15,
  planet: 97.05 / 122.88,
  constellation: 273.23 / 512,
};

// Measured rendered height of `.decorated-content` (index.astro) across the
// 1024-1440px desktop range this component is shown at: ~1436-1485px. A mid-range
// figure keeps this safe in both directions — see the file-level comment above.
const REFERENCE_HEIGHT = 1460;
const MIN_GAP = 40;

// How far each item's card-facing edge targets, inward from `.decorated-content`'s own
// edge (which is also the container project-list's cards sit in — see the file-level
// comment on horizontal placement). Small items scale their reach with their own width
// (proportional, so they don't over- or under-poke relative to their size); wide items
// (mainly the planes) are capped at H_INSET_CAP regardless of width, since scaling
// their reach the same way would land well past the ~24px project-list padding this is
// staying clear of. Each item's own hJitter (defined per-item below) then varies this
// target a bit either way, per item, for "not all landing at an identical reach."
const H_INSET_CAP = 6;
const H_INSET_FRACTION = 0.28;
// Astronauts get an extra pad here: the flag is composited overlapping the astronaut
// image's card-facing corner (right:-18% in .astronaut-flag's CSS) and extends past the
// image's own box, so its effective width for this calculation needs to include that
// overshoot even though the rendered <img> itself doesn't.
const H_INWARD_PAD: Record<string, number> = { astronaut: 1.2 };

type DecorItem = {
  type: 'plane' | 'astronaut' | 'planet' | 'constellation';
  side: 'left' | 'right';
  width: number;
  opacity: number;
  hJitter: number;
  flip?: boolean;
  color?: string;
  start?: [number, number];
  end?: [number, number];
  loopRadius?: number;
  loopTurns?: number;
  loopDir?: 1 | -1;
};

// Stacks a track's items top-to-bottom with a minimum gap, then — since there's
// usually slack left in REFERENCE_HEIGHT once every item's real height is accounted
// for — spreads that slack evenly into every gap (including above the first item and
// below the last) rather than bunching everything at the top. Guarantees no overlap
// by construction: each item's `topPercent` sits strictly after the previous item's
// bottom edge plus the gap. Also computes each item's `hOffsetPx` — the left:/right:
// value that lands its card-facing edge at min(H_INSET_CAP, width*H_INSET_FRACTION),
// +/- its own jitter; see the file-level comment on horizontal placement for why this
// beats a flat target shared by every item regardless of width.
function layoutTrack<T extends { width: number; type: string; hJitter: number }>(items: T[]) {
  const heights = items.map((it) => it.width * ASPECT[it.type]);
  const totalHeight = heights.reduce((sum, h) => sum + h, 0);
  const gapCount = items.length + 1;
  const gap = Math.max(MIN_GAP, (REFERENCE_HEIGHT - totalHeight) / gapCount);
  let cursor = gap;
  return items.map((it, i) => {
    const topPercent = (cursor / REFERENCE_HEIGHT) * 100;
    cursor += heights[i] + gap;
    const effectiveWidth = it.width * (H_INWARD_PAD[it.type] ?? 1);
    const inwardTarget = Math.min(H_INSET_CAP, effectiveWidth * H_INSET_FRACTION) + it.hJitter;
    const hOffsetPx = inwardTarget - effectiveWidth;
    return { ...it, topPercent, hOffsetPx };
  });
}

// Two independently-laid-out tracks (left/right edge), each mixing every decor type in
// an interleaved, non-grouped order for an organic/"random" feel rather than banding
// all the planes together, then all the astronauts, etc. Plane items carry their
// loop-trail config (start/end/loopRadius/loopTurns/loopDir); layoutTrack() only reads
// `width`/`type`/`hJitter` and passes every other field through untouched. Sizes here
// are roughly half of the original pass's — hJitter (px, added to the inward-reach
// target in layoutTrack) is hand-varied per item so the now-smaller icons don't all
// land at identical horizontal reach, per the "vary a bit horizontally" ask.
const LEFT_ITEMS: DecorItem[] = [
  { type: 'plane', side: 'left', width: 53, opacity: 0.4, hJitter: -4, start: [-6, 30], end: [60, 13], loopRadius: 9, loopTurns: 1.2, loopDir: 1 },
  { type: 'astronaut', side: 'left', width: 26, opacity: 0.32, hJitter: 5, flip: false },
  { type: 'planet', side: 'left', width: 19, opacity: 0.3, hJitter: -2, color: '#e893c2' },
  { type: 'constellation', side: 'left', width: 28, opacity: 0.28, hJitter: 5 },
  { type: 'plane', side: 'left', width: 43, opacity: 0.28, hJitter: -5, start: [-6, 8], end: [66, 40], loopRadius: 7, loopTurns: 1.05, loopDir: -1 },
  { type: 'planet', side: 'left', width: 21, opacity: 0.28, hJitter: 4, color: '#6fd19a' },
  { type: 'astronaut', side: 'left', width: 27, opacity: 0.28, hJitter: -3, flip: false },
  { type: 'plane', side: 'left', width: 60, opacity: 0.34, hJitter: 6, start: [-6, 48], end: [58, 18], loopRadius: 10, loopTurns: 1.3, loopDir: 1 },
  { type: 'constellation', side: 'left', width: 26, opacity: 0.24, hJitter: 0 },
  { type: 'planet', side: 'left', width: 23, opacity: 0.34, hJitter: -5, color: '#e0736f' },
  { type: 'plane', side: 'left', width: 39, opacity: 0.24, hJitter: 4, start: [-6, 20], end: [70, 50], loopRadius: 6, loopTurns: 1.0, loopDir: -1 },
];

const RIGHT_ITEMS: DecorItem[] = [
  { type: 'plane', side: 'right', width: 55, opacity: 0.4, hJitter: 3, start: [96, 26], end: [28, 9], loopRadius: 9, loopTurns: 1.15, loopDir: -1 },
  { type: 'planet', side: 'right', width: 22, opacity: 0.34, hJitter: -5, color: '#e0736f' },
  { type: 'constellation', side: 'right', width: 29, opacity: 0.3, hJitter: 2 },
  { type: 'plane', side: 'right', width: 41, opacity: 0.28, hJitter: -4, start: [96, 6], end: [22, 38], loopRadius: 7, loopTurns: 1.1, loopDir: 1 },
  { type: 'astronaut', side: 'right', width: 30, opacity: 0.3, hJitter: 6, flip: true },
  { type: 'planet', side: 'right', width: 25, opacity: 0.32, hJitter: -4, color: '#a97fd1' },
  { type: 'plane', side: 'right', width: 63, opacity: 0.36, hJitter: 0, start: [96, 46], end: [34, 16], loopRadius: 10.5, loopTurns: 1.25, loopDir: -1 },
  { type: 'planet', side: 'right', width: 18, opacity: 0.3, hJitter: 5, color: '#e893c2' },
  { type: 'plane', side: 'right', width: 38, opacity: 0.22, hJitter: -3, start: [96, 20], end: [20, 48], loopRadius: 6.5, loopTurns: 1.0, loopDir: 1 },
];

const ALL_ITEMS = [...layoutTrack(LEFT_ITEMS), ...layoutTrack(RIGHT_ITEMS)];

const PLANE_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'plane').map((p) => {
  const { pathD, endAngleDeg } = buildLoopTrail({
    startX: p.start![0],
    startY: p.start![1],
    endX: p.end![0],
    endY: p.end![1],
    loopRadius: p.loopRadius!,
    loopTurns: p.loopTurns!,
    loopDirection: p.loopDir!,
  });
  return { ...p, pathD, endAngleDeg, endX: p.end![0], endY: p.end![1] };
});
const ASTRONAUT_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'astronaut');
const PLANET_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'planet');
const CONSTELLATION_CONFIGS = ALL_ITEMS.filter((it) => it.type === 'constellation');
---

<div class="space-decor" aria-hidden="true">
  {
    PLANE_CONFIGS.map((p) => (
      <svg
        class={`plane plane-${p.side}`}
        style={`top:${p.topPercent.toFixed(2)}%; ${p.side}:${Math.round(p.hOffsetPx)}px; width:${p.width}px; opacity:${p.opacity};`}
        viewBox="0 0 90 60"
      >
        <path d={p.pathD} class="plane-trail" />
        <g
          transform={`translate(${p.endX},${p.endY}) rotate(${(p.endAngleDeg + PLANE_ROTATION_OFFSET).toFixed(1)}) scale(${PLANE_ICON_SCALE}) translate(${-PLANE_VIEWBOX_CENTER.x},${-PLANE_VIEWBOX_CENTER.y})`}
        >
          <path class="deco-icon" d={PLANE_PATH} />
        </g>
      </svg>
    ))
  }

  {
    ASTRONAUT_CONFIGS.map((a) => (
      <div
        class={`astronaut astronaut-${a.side}`}
        style={`top:${a.topPercent.toFixed(2)}%; ${a.side}:${Math.round(a.hOffsetPx)}px; width:${a.width}px; opacity:${a.opacity}; ${a.flip ? 'transform:scaleX(-1);' : ''}`}
      >
        <Image src={astronautFloating} alt="" width={200} height={200} class="astronaut-img" />
        <svg class="astronaut-flag" viewBox={FLAG_VIEWBOX}>
          <path class="deco-icon" d={FLAG_PATH} />
        </svg>
      </div>
    ))
  }

  {
    PLANET_CONFIGS.map((p) => (
      <svg
        class={`planet planet-${p.side}`}
        style={`top:${p.topPercent.toFixed(2)}%; ${p.side}:${Math.round(p.hOffsetPx)}px; width:${p.width}px; opacity:${p.opacity};`}
        viewBox={SATURN_VIEWBOX}
      >
        <path d={SATURN_PATH} style={`fill:${p.color};`} />
      </svg>
    ))
  }

  {
    CONSTELLATION_CONFIGS.map((c) => (
      <svg
        class={`constellation constellation-${c.side}`}
        style={`top:${c.topPercent.toFixed(2)}%; ${c.side}:${Math.round(c.hOffsetPx)}px; width:${c.width}px; opacity:${c.opacity};`}
        viewBox={CONSTELLATION_VIEWBOX}
      >
        <path class="deco-icon" fill-rule="nonzero" d={CONSTELLATION_PATH} />
      </svg>
    ))
  }
</div>

<style>
  .space-decor {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    overflow: visible;
  }

  .plane,
  .astronaut,
  .planet,
  .constellation {
    position: absolute;
    height: auto;
    overflow: visible;
  }

  .plane-trail {
    fill: none;
    stroke: #ffffff;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 1.5 4.5;
  }

  .deco-icon {
    fill: #ffffff;
  }

  .astronaut-img {
    width: 100%;
    height: auto;
    display: block;
    /* Source PNG is black-on-transparent (Noun Project's export) — forced white to
       match the site's monochrome decorative treatment rather than tinting via
       currentColor/fill, which doesn't apply to raster images. */
    filter: brightness(0) invert(1);
  }

  .astronaut-flag {
    position: absolute;
    top: -6%;
    right: -18%;
    width: 34%;
    height: auto;
  }

  @media (max-width: 720px) {
    .space-decor {
      display: none;
    }
  }
</style>
