---
// DD_v2.md §4.2 — sparse index card. Explicitly NOT shown here: full description,
// tags, tools, links, versions, sub-items, the supplementary images array — all of
// that lives on the detail page only (§6). The card's job is to make someone want to
// click, not tell the whole story.
import { Image } from 'astro:assets';
import StatusDot from './StatusDot.svelte';
import { getBlockAsset } from '../lib/blockAssets';
import { withBase } from '../lib/url';

interface Props {
  block: {
    slug: string;
    title: string;
    cardSummary: string;
    status: 'ongoing' | 'paused' | 'completed';
    heroImage: { src: string; alt: string };
  };
}

const { block } = Astro.props;
const heroAsset = getBlockAsset(block.slug, block.heroImage.src);
const href = withBase(`projects/${block.slug}/`);
---

<article class="project-card" data-reveal>
  <a class="card-image-link" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={heroAsset}
      alt={block.heroImage.alt}
      width={1400}
      height={820}
      class="card-image"
    />
  </a>
  <div class="card-body">
    <StatusDot status={block.status} />
    <h3 class="card-title"><a href={href}>{block.title}</a></h3>
    <p class="card-summary">{block.cardSummary}</p>
    <a class="learn-more" href={href}>Learn More →</a>
  </div>
</article>

<style>
  .project-card {
    /* DD_v2.1.md §4.4 — sizing now comes from the parent grid's column track (see
       index.astro's .project-list), not from the card centering itself as a single
       stacked column (that was v2's layout). */
    opacity: 1;
    transform: none;
  }

  /* Slide in from the side rather than up — left-column cards (odd position in DOM
     order, matching the 2-col grid's left track) come from the left, right-column
     (even) from the right, so they read as entering from either side of the page
     rather than all sharing one direction. Small distance + ease-out curve on
     purpose: a minor ramp-in, not a swoop. */
  .project-card[data-reveal] {
    opacity: 0;
    transition: opacity 650ms cubic-bezier(0.16, 1, 0.3, 1), transform 650ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* :where() keeps these at the same specificity as [data-reveal] itself — without it,
     :nth-child adds enough specificity to beat .is-visible's transform:none below, so
     revealed cards would fade in but stay stuck at their offset forever. */
  .project-card[data-reveal]:where(:nth-child(odd)) {
    transform: translateX(-28px);
  }

  .project-card[data-reveal]:where(:nth-child(even)) {
    transform: translateX(28px);
  }

  .project-card.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card[data-reveal] {
      transition: none;
    }
  }

  .card-image-link {
    display: block;
    border-radius: 10px;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1400 / 820;
    object-fit: cover;
  }

  .card-body {
    padding: 1.25rem 0.25rem 0;
  }

  .card-title {
    margin: 0.6rem 0 0.4rem;
    font-size: 1.4rem;
  }

  .card-title a {
    text-decoration: none;
    color: var(--page-text);
  }

  .card-title a:hover {
    color: var(--accent);
  }

  .card-summary {
    margin: 0 0 0.9rem;
    color: var(--page-text-dim);
    max-width: 60ch;
  }

  .learn-more {
    display: inline-block;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    border-bottom: 1px solid transparent;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .learn-more:hover {
    color: var(--accent-soft);
    border-color: currentColor;
  }
</style>
