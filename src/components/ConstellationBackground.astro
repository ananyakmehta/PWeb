---
// DD_initial_build.md §8.1 — base layer, constant across the whole page, sits behind
// every section (including themed block sections, which coexist with it rather than
// hiding it — see Block.astro's use of z-index-layered, semi-transparent block
// backgrounds). Static SVG, no JS: cheap, and there's nothing here that needs to
// react to state.
import { constellations } from '../data/constellations';
---

<div class="constellation-layer" aria-hidden="true">
  {
    constellations.map((c) => (
      <svg
        class="constellation"
        style={`left:${c.box.left}vw; top:${c.box.top}vh; width:${c.box.width}vw; height:${c.box.height}vh;`}
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
      >
        <g stroke={c.color} stroke-width="0.3" fill={c.color} opacity="0.55">
          {c.lines.map(([a, b]) => (
            <line
              x1={c.stars[a].x}
              y1={c.stars[a].y}
              x2={c.stars[b].x}
              y2={c.stars[b].y}
            />
          ))}
        </g>
        {c.stars.map((s, i) => (
          <circle
            class="star"
            cx={s.x}
            cy={s.y}
            r={s.r}
            fill={c.color}
            style={`animation-delay: ${(i * 0.6).toFixed(2)}s;`}
          />
        ))}
      </svg>
    ))
  }
</div>

<style>
  .constellation-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    opacity: 0.4; /* dimmed, per §8.1 */
  }

  .constellation {
    position: absolute;
  }

  .star {
    animation: twinkle 4.5s ease-in-out infinite;
    transform-origin: center;
    transform-box: fill-box;
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .star {
      animation: none;
    }
  }
</style>
