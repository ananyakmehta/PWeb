---
// Detail page redesign, direct instruction (not doc-governed) — referenced against
// https://www.davisryan.tech/pocket-rocket for the heading treatment: a full-bleed,
// darkened hero image with the title overlaid on top, rather than a plain image
// followed by a separate heading. Below that: 4 alternating image/text sections
// stacked vertically (image-right/text-left, then image-left/text-right, repeating) —
// vertical rows here rather than the reference's own arrangement, per direct
// instruction. Same slide-in reveal as the index page's project cards (shared via
// src/lib/scrollReveal.ts), with each section's slide direction matching which side
// its own image is on.
//
// SCOPE NOTE: this replaces the old images-array grid and the old
// versions/currentWork/impact/links block-specific conditional content (§6 in
// DD_v2/v2.1) — those don't have an obvious place in the new 4-section pattern, and
// the sections here are uniform placeholder content across every project rather than
// per-block-varied, matching "put 4 placeholder sections" rather than trying to
// shoehorn the old per-project fields into the new layout. That real per-project data
// (versions, currentWork, impact, links beyond the meta area) still exists in the
// schema/content files — it's just not rendered on this page this pass. primaryDescription
// is kept as a short intro blurb between the meta row and the sections, since it still
// fits naturally and there was no reason to discard working content.
import { Image } from 'astro:assets';
import StatusDot from './StatusDot.svelte';
import NerdNumbers from './NerdNumbers.svelte';
import { getBlockAsset } from '../lib/blockAssets';
import { withBase } from '../lib/url';
import { splitParagraphs } from '../lib/text';
import section1 from '../assets/sections/1.svg';
import section2 from '../assets/sections/2.svg';
import section3 from '../assets/sections/3.svg';
import section4 from '../assets/sections/4.svg';

interface Props {
  block: any;
}

const { block } = Astro.props;

const heroAsset = getBlockAsset(block.slug, block.heroImage.src);
const dateRange = `${block.dateStart} – ${block.dateEnd ?? 'Ongoing'}`;
const allTags = [...block.typeTags, ...block.topicTags];

// Placeholder content — used only for projects that don't have real `sections` in
// their frontmatter yet (see detailSectionSchema in src/content.config.ts), same 4
// sections for every such project, alternating image side starting with
// image-right/text-left per the original direct instruction.
const PLACEHOLDER_SECTIONS = [
  {
    heading: '[Placeholder] Section One',
    body: '[Placeholder copy] Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua — standing in for the real section copy.',
  },
  {
    heading: '[Placeholder] Section Two',
    body: '[Placeholder copy] Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat — standing in for the real section copy.',
  },
  {
    heading: '[Placeholder] Section Three',
    body: '[Placeholder copy] Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur — standing in for the real section copy.',
  },
  {
    heading: '[Placeholder] Section Four',
    body: '[Placeholder copy] Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum — standing in for the real section copy.',
  },
];

// Decorative side images/alternation are independent of whether the text is real or
// placeholder — no real per-section images exist yet (see the .md source this content
// came from, which specifies text only), so real-content sections reuse the same
// generic placeholder art in the same alternating pattern rather than going without.
const SECTION_IMAGES = [section1, section2, section3, section4];
const SECTION_SIDES = ['right', 'left', 'right', 'left'];

const sectionContent = block.sections?.length > 0 ? block.sections : PLACEHOLDER_SECTIONS;
const SECTIONS = sectionContent.map((s: any, i: number) => ({
  ...s,
  image: SECTION_IMAGES[i % SECTION_IMAGES.length],
  side: SECTION_SIDES[i % SECTION_SIDES.length],
}));
---

<article class="project-detail">
  <div class="detail-hero">
    <Image src={heroAsset} alt={block.heroImage.alt} width={1800} height={900} class="detail-hero-image" />
    <div class="detail-hero-overlay">
      <div class="detail-hero-overlay-inner">
        <h1>{block.title}</h1>
      </div>
    </div>
  </div>

  <div class="detail-body">
    <div class="meta-row">
      <p class="date-range">{dateRange}</p>
      <StatusDot status={block.status} />
    </div>

    {
      allTags.length > 0 && (
        <div class="tags">
          {allTags.map((t: string) => (
            <span class="tag">{t}</span>
          ))}
        </div>
      )
    }

    {
      splitParagraphs(block.primaryDescription).map((p: string) => (
        <p class="description">{p}</p>
      ))
    }

    <div class="sections">
      {
        SECTIONS.map((s) => (
          <div class={`detail-section side-${s.side}`} data-reveal>
            <div class="detail-section-image">
              <Image src={s.image} alt="" width={1000} height={750} />
            </div>
            <div class="detail-section-text">
              <h2>{s.heading}</h2>
              {splitParagraphs(s.body).map((p: string) => (
                <p>{p}</p>
              ))}
              {s.nerdNumbers && (
                <NerdNumbers client:load paragraphs={splitParagraphs(s.nerdNumbers)} />
              )}
            </div>
          </div>
        ))
      }
    </div>

    {
      (block.tools?.length ?? 0) > 0 && (
        <p class="tools-row">
          <span class="tools-label">Tools:</span> {block.tools.join(' · ')}
        </p>
      )
    }

    <a class="back-link" href={withBase('#projects')}>
      ← Back to projects
    </a>
  </div>
</article>

<style>
  .project-detail {
    padding-bottom: 4rem;
    /* Single source of truth for the content column's width/inset, shared by
       .detail-body below AND .detail-hero-overlay-inner (the full-bleed hero title,
       which otherwise has no relationship to .detail-body's own width) — direct
       instruction that the "Torque ML Project" heading line up with the intro
       text's own left edge. Using the exact same max-width + auto-margin +
       padding-left recipe in both places, off one shared pair of values, is what
       keeps them aligned at every viewport width automatically rather than only at
       whatever width they happened to be measured against.
       max-width was 1000px, padding-h was 1.5rem — per direct instruction to cut
       the side margins roughly in half and let content use more of the screen. */
    --detail-max-width: 1300px;
    --detail-pad-h: 0.75rem;
  }

  /* Full-bleed, matching the index hero mosaic's own breakout — the detail page's
     content body below is still constrained (see .detail-body), but the heading image
     goes edge-to-edge for the same reason the reference page's hero does. */
  .detail-hero {
    position: relative;
    width: 100vw;
    margin-left: calc(50% - 50vw);
    height: 46vh;
    min-height: 320px;
    max-height: 520px;
    overflow: hidden;
  }

  .detail-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .detail-hero-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    background: linear-gradient(to top, rgba(4, 8, 14, 0.75), rgba(4, 8, 14, 0.15) 55%, rgba(4, 8, 14, 0.35));
    padding-bottom: 2.5rem;
  }

  /* Horizontal alignment lives here instead of on .detail-hero-overlay itself — same
     max-width/auto-margin/padding as .detail-body (via the shared vars above), so
     the title's left edge always lands exactly on the intro text's own left edge. */
  .detail-hero-overlay-inner {
    width: 100%;
    max-width: var(--detail-max-width);
    margin: 0 auto;
    padding: 0 var(--detail-pad-h);
  }

  .detail-hero-overlay h1 {
    margin: 0;
    color: #ffffff;
    font-size: 2.6rem;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .detail-body {
    max-width: var(--detail-max-width);
    margin: 0 auto;
    padding: 2rem var(--detail-pad-h) 0;
    /* Slide-in scroll-reveal sections (see src/lib/scrollReveal.ts, and .sections
       below) sit translateX()'d up to 36px off their resting position until they
       scroll into view — meant to be just off-screen, not an actual
       horizontally-scrollable page. Narrowing this page's own side margins above
       left less slack for that, producing a real if transient horizontal
       scrollbar at medium viewport widths whenever an off-screen section was
       still in its pre-reveal state. Scoped to .detail-body specifically, not
       .project-detail or body/html: .detail-hero (a sibling of this element, not
       a descendant) relies on overflowing ITS OWN container via negative margins
       for its full-bleed edge-to-edge effect, which overflow-x:hidden anywhere
       above it in the tree would clip — and overflow-x:hidden on any ancestor of
       a position:sticky element (the index page's pinned hero mosaic, on an
       entirely different route from this one, but body/html are ancestors of
       both) disables that element's stickiness. Confirmed both the hard way. */
    overflow-x: hidden;
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .date-range {
    margin: 0;
    color: var(--page-text-dim);
    font-size: 0.9rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.9rem 0;
  }

  .tag {
    font-size: 0.72rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    background: var(--chip-bg);
    color: var(--chip-text);
    text-transform: capitalize;
  }

  .description {
    color: var(--page-text);
    line-height: 1.6;
    /* Widened from 65ch alongside .detail-body's own max-width increase — per direct
       instruction that the TEXT itself take up more of the screen, not just the
       (now wider) empty space around it. Still capped, short of .detail-body's full
       width, so paragraph lines don't get uncomfortably long to read. */
    max-width: 80ch;
    /* primaryDescription can now be multiple paragraphs (see splitParagraphs()),
       each its own .description <p> — the first needs the full gap down from the
       tags row above it, consecutive ones just need normal paragraph spacing. */
    margin: 1rem 0 0;
  }

  .description + .description {
    margin-top: 0.85rem;
  }

  .sections {
    margin-top: 1rem;
  }

  .detail-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin: 5rem 0;
  }

  .detail-section.side-right .detail-section-image {
    order: 2;
  }

  .detail-section.side-right .detail-section-text {
    order: 1;
  }

  .detail-section-image :global(img) {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .detail-section-text h2 {
    margin: 0 0 0.75rem;
    font-size: 1.5rem;
  }

  .detail-section-text p {
    margin: 0;
    color: var(--page-text-dim);
    line-height: 1.6;
  }

  /* Section body can now be multiple paragraphs (see splitParagraphs()) — normal
     paragraph spacing between them, none needed above the first (h2 already has its
     own bottom margin). */
  .detail-section-text p + p {
    margin-top: 0.85rem;
  }

  /* Same slide-in as the index page's project cards (§ ProjectCard.astro) — direction
     matches which side this section's own image is on, so the motion reinforces the
     layout rather than being arbitrary. Replayable via the shared IntersectionObserver
     in src/lib/scrollReveal.ts (toggles past a 50% visibility threshold). */
  .detail-section[data-reveal] {
    opacity: 0;
    transition: opacity 900ms cubic-bezier(0.16, 1, 0.3, 1), transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .detail-section.side-right[data-reveal]:where(:not(.is-visible)) {
    transform: translateX(36px);
  }

  .detail-section.side-left[data-reveal]:where(:not(.is-visible)) {
    transform: translateX(-36px);
  }

  .detail-section.is-visible {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 720px) {
    .detail-hero-overlay h1 {
      font-size: 1.9rem;
    }

    .detail-section {
      grid-template-columns: 1fr;
      gap: 1.25rem;
      margin: 3rem 0;
    }

    .detail-section.side-right .detail-section-image,
    .detail-section.side-right .detail-section-text,
    .detail-section.side-left .detail-section-image,
    .detail-section.side-left .detail-section-text {
      order: initial;
    }
  }

  .tools-row {
    margin-top: 1.5rem;
    font-size: 0.78rem;
    color: var(--page-text-dim);
  }

  .tools-label {
    font-weight: 600;
    margin-right: 0.3rem;
  }

  .back-link {
    display: inline-block;
    margin-top: 2.5rem;
    color: var(--page-text-dim);
    text-decoration: none;
    font-size: 0.88rem;
  }

  .back-link:hover {
    color: var(--accent);
  }
</style>

<script>
  import { initScrollReveal } from '../lib/scrollReveal';
  initScrollReveal();
</script>
